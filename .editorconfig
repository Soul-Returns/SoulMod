root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# ktlint config — opinionated relaxations matching this codebase's existing style.
ktlint_standard_filename = disabled
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_class-naming = disabled
# Allow trailing-comma style preferred by Kotlin docs / IntelliJ default.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
# Soul mod uses §-codes and Unicode glyphs (↳, ⏣, ൠ, →, etc.) in user-facing strings — don't fight that.
ktlint_standard_no-unused-imports = enabled

[*.{json,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
