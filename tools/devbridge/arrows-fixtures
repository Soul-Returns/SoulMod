#!/usr/bin/env python3
"""Arrow Align fixtures: the device's signals cut from a dev bridge recording (format v2).

    tools/devbridge/arrows-fixtures <recording.rec.ndjson.zst> <out.ndjson.gz> [--episode N]

Finds every Arrow Align episode (clicks = `entity.item_frame.rotate_item` sounds at a frame of the 5x5 grid, frame
blocks x -2, y 120..124, z 75..79; click clusters more than 60 s apart are separate episodes) and writes episode N
(1-based, default 1), from 3 s before its first click to 3 s after its last. One compact line per event; `t` = client
arrival in ms, `tick` = the server tick from the recording's clock:
  {"t":…,"tick":N,"k":"add","id":…,"y":…,"z":…}          an item frame appears (the frames alive at the first click are
                                                            re-emitted at the window's start, with their data)
  {"t":…,"tick":N,"k":"data","id":…,"item":"arrow|lime_wool|red_wool|<other>","rot":0..7}
        set_entity_data of a frame: its item (stack id) and/or its rotation (entity data id 10); absent = unchanged
  {"t":…,"tick":N,"k":"remove","id":…}                    the frame leaves the client
  {"t":…,"tick":N,"k":"back","y":…,"z":…,"s":"sea_lantern|blue_terracotta|…"}
        a change of the block behind a frame (x -3): a sea lantern exactly while the arrow is at its target
        (only changes; the state before the first one is not in the file)
  {"t":…,"tick":N,"k":"click","y":…,"z":…}                the player's own click, known from the rotate sound the server
                                                            plays at the frame (the recordings hold no outbound packets;
                                                            it arrives one latency after the click, just before the lantern
                                                            and the new rotation of the same tick)
  {"t":…,"tick":N,"k":"chat","s":"…"}                     `completed a device!` lines
Used by ArrowAlignFixturesTest (src/test/resources/devices/).
"""
import gzip
import json
import subprocess
import sys


def in_frames(x, y, z):
    return -4 <= x <= 0 and 119 <= y <= 126 and 74 <= z <= 81


def short(s):
    return s.replace("minecraft:", "").split("[")[0]


def read(src):
    cmd = ["zstd", "-dc", src] if src.endswith(".zst") else ["gzip", "-dc", src]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    events = []
    frames = {}  # id -> (y, z) while alive
    for line in proc.stdout:
        try:
            o = json.loads(line)
        except ValueError:
            continue
        kind = o.get("kind")
        d = o.get("data") or {}
        if kind == "header":
            if d.get("version") != 2:
                sys.exit(f"{src}: recording format v{d.get('version')}; only v2 has the entity data")
            continue
        t, tick = o.get("t"), o.get("tick")
        if kind == "chat":
            s = d.get("text") or ""
            if "completed a device!" in s:
                events.append({"t": t, "tick": tick, "k": "chat", "s": s})
            continue
        if kind != "packet":
            continue
        typ = d.get("type")
        p = d.get("data") or {}
        if typ == "minecraft:add_entity":
            if p.get("type") == "minecraft:item_frame" and in_frames(p["x"], p["y"], p["z"]):
                frames[p["id"]] = (int(p["y"] // 1), int(p["z"] // 1))
                events.append({"t": t, "tick": tick, "k": "add", "id": p["id"], "y": frames[p["id"]][0], "z": frames[p["id"]][1]})
        elif typ == "minecraft:set_entity_data":
            if p.get("id") in frames:
                e = {"t": t, "tick": tick, "k": "data", "id": p["id"]}
                for it in p.get("packedItems") or []:
                    if it["id"] == 9:
                        e["item"] = short(it["value"]["id"]) if it["value"] else "air"
                    elif it["id"] == 10:
                        e["rot"] = it["value"]
                if "item" in e or "rot" in e:
                    events.append(e)
        elif typ == "minecraft:remove_entities":
            for i in p.get("entityIds") or p.get("ids") or []:
                if i in frames:
                    del frames[i]
                    events.append({"t": t, "tick": tick, "k": "remove", "id": i})
        elif typ == "minecraft:block_update":
            pos = p.get("pos") or {}
            back(events, t, tick, pos.get("x"), pos.get("y"), pos.get("z"), p["blockState"])
        elif typ == "minecraft:section_blocks_update":
            states = p.get("states") or []
            for x, y, z, i in p.get("changes") or []:
                back(events, t, tick, x, y, z, states[i])
        elif typ == "minecraft:sound":
            if p.get("sound") == "minecraft:entity.item_frame.rotate_item":
                x, y, z = p["x"] / 8.0, p["y"] / 8.0, p["z"] / 8.0
                if in_frames(x, y, z):
                    events.append({"t": t, "tick": tick, "k": "click", "y": int(y // 1), "z": int(z // 1)})
    proc.wait()
    return events


def back(events, t, tick, x, y, z, state):
    if x == -3 and y is not None and 120 <= y <= 124 and 75 <= z <= 79:
        events.append({"t": t, "tick": tick, "k": "back", "y": y, "z": z, "s": short(state)})


def main(argv):
    if len(argv) < 3:
        sys.exit(__doc__)
    src, dst = argv[1], argv[2]
    episode = int(argv[argv.index("--episode") + 1]) if "--episode" in argv else 1
    events = read(src)
    clicks = [e for e in events if e["k"] == "click"]
    groups = []
    for c in clicks:
        if groups and c["t"] - groups[-1][-1]["t"] <= 60000:
            groups[-1].append(c)
        else:
            groups.append([c])
    if episode > len(groups):
        sys.exit(f"{src}: {len(groups)} Arrow Align episode(s)")
    first, last = groups[episode - 1][0]["t"], groups[episode - 1][-1]["t"]
    lo, hi = first - 3000, last + 3000
    # The frames alive at the window's start, as if they had just appeared. The lanterns are not carried over: the
    # recordings only hold changes, and the block states of an earlier fight (a new server) are not this one's.
    alive, item, rot = {}, {}, {}
    for e in events:
        if e["t"] >= lo:
            break
        if e["k"] == "add":
            alive[e["id"]] = (e["y"], e["z"])
            item[e["id"]], rot[e["id"]] = None, None
        elif e["k"] == "data" and e["id"] in alive:
            item[e["id"]] = e.get("item", item[e["id"]])
            rot[e["id"]] = e.get("rot", rot[e["id"]])
        elif e["k"] == "remove":
            alive.pop(e["id"], None)
    keep = []
    for i, (y, z) in alive.items():
        keep.append({"t": lo, "tick": None, "k": "add", "id": i, "y": y, "z": z})
        d = {"t": lo, "tick": None, "k": "data", "id": i}
        if item[i] is not None:
            d["item"] = item[i]
        if rot[i] is not None:
            d["rot"] = rot[i]
        keep.append(d)
    keep += [e for e in events if lo <= e["t"] <= hi]
    # Stable by arrival time: the file's own order holds within one tick (sound, then the lantern, then the frame's data).
    keep.sort(key=lambda e: e["t"])
    with gzip.open(dst, "wt") as f:
        for e in keep:
            f.write(json.dumps(e, separators=(",", ":")) + "\n")
    print(f"{dst}: episode {episode}/{len(groups)}, {len(keep)} events, {sum(1 for e in keep if e['k'] == 'click')} clicks")


if __name__ == "__main__":
    main(sys.argv)
