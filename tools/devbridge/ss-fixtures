#!/usr/bin/env python3
"""Simon Says fixtures: the device's signals cut from a dev bridge recording (format v2).

    tools/devbridge/ss-fixtures <recording.rec.ndjson.zst> <out.ndjson.gz> [--episode N]

Finds every Simon Says episode (start button presses at (110,121,91)) and writes episode N (1-based,
default 1), from 3 s before its first start press to 2 s after `completed a device!`. One compact
line per event; `t` = client arrival in ms, `tick` = the server tick from the recording's clock:
  {"t":…,"tick":N,"k":"block","x":…,"y":…,"z":…,"s":"sea_lantern|obsidian|stone_button|air|…"}
        every block_update / section_blocks_update entry at x 109..111, y 119..124, z 90..96
  {"t":…,"tick":N,"k":"press","x":110,"y":…,"z":…}
        the player's own press, recognized from the server's answer to it: the pressed button re-sent
        (powered=false) plus a neighbour block re-sent within 60 ms (the recordings hold no outbound
        packets, so this answer is the only trace of a press; it arrives one latency after the click)
  {"t":…,"tick":N,"k":"sound","id":"pling|error","x":…,"y":…,"z":…}
        block.note_block.pling (volume 8) / entity.enderman.teleport (volume 8, pitch 0) within 8 blocks
  {"t":…,"tick":N,"k":"chat","s":"…"}     `completed a device!` lines
Used by SimonSaysFixturesTest (src/test/resources/devices/).
"""
import gzip
import json
import subprocess
import sys

GRID = (110, 121, 93)


def near(x, y, z, r=8.0):
    return (x - GRID[0]) ** 2 + (y - GRID[1]) ** 2 + (z - GRID[2]) ** 2 <= r * r


def in_box(x, y, z):
    return 109 <= x <= 111 and 119 <= y <= 124 and 90 <= z <= 96


def short(state):
    s = state.replace("minecraft:", "")
    return s.split("[")[0]


def read(src):
    cmd = ["zstd", "-dc", src] if src.endswith(".zst") else ["gzip", "-dc", src]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    out = []
    version = None
    for line in proc.stdout:
        try:
            o = json.loads(line)
        except ValueError:
            continue
        kind = o.get("kind")
        d = o.get("data") or {}
        if kind == "header":
            version = d.get("version")
            if version != 2:
                sys.exit(f"{src}: recording format v{version}; only v2 has full block states")
            continue
        t = o.get("t")
        tick = o.get("tick")
        if kind == "chat":
            s = d.get("text") or ""
            if "completed a device!" in s:
                out.append({"t": t, "tick": tick, "k": "chat", "s": s})
            continue
        if kind != "packet":
            continue
        typ = d.get("type")
        p = d.get("data") or {}
        if typ == "minecraft:block_update":
            pos = p.get("pos") or {}
            x, y, z = pos.get("x"), pos.get("y"), pos.get("z")
            if x is not None and in_box(x, y, z):
                out.append({"t": t, "tick": tick, "k": "block", "x": x, "y": y, "z": z, "s": short(p["blockState"]), "raw": p["blockState"]})
        elif typ == "minecraft:section_blocks_update":
            states = p.get("states") or []
            for x, y, z, i in p.get("changes") or []:
                if in_box(x, y, z):
                    out.append({"t": t, "tick": tick, "k": "block", "x": x, "y": y, "z": z, "s": short(states[i]), "raw": states[i], "sec": True})
        elif typ == "minecraft:sound":
            x, y, z = p["x"] / 8.0, p["y"] / 8.0, p["z"] / 8.0
            if not near(x, y, z):
                continue
            sid = p.get("sound")
            if sid == "minecraft:block.note_block.pling" and p.get("volume") == 8.0:
                out.append({"t": t, "tick": tick, "k": "sound", "id": "pling", "x": x, "y": y, "z": z})
            elif sid == "minecraft:entity.enderman.teleport" and p.get("volume") == 8.0 and p.get("pitch") == 0.0:
                out.append({"t": t, "tick": tick, "k": "sound", "id": "error", "x": x, "y": y, "z": z})
    proc.wait()
    return out


def presses(events):
    """Single block_update answers: a button re-sent with powered=false plus a neighbour within 60 ms."""
    singles = [e for e in events if e["k"] == "block" and not e.get("sec")]
    used = set()
    found = []
    for i, a in enumerate(singles):
        if i in used or a["x"] != 110 or a["s"] != "stone_button" or "powered=false" not in a["raw"]:
            continue
        near_ = []
        for j in range(i + 1, len(singles)):
            b = singles[j]
            if b["t"] - a["t"] > 60:
                break
            # x 111 is the lamp behind: that pair (sent twice, no pling) answers a left click, not a press.
            if j not in used and b["x"] != 111 and abs(b["x"] - a["x"]) + abs(b["y"] - a["y"]) + abs(b["z"] - a["z"]) == 1:
                near_.append(j)
        if not near_:
            continue
        # The block in front of the button (x 109) when it is there: a neighbouring button may be placed in the same tick.
        front = [j for j in near_ if singles[j]["x"] == 109]
        j = (front or near_)[0]
        used.add(i)
        used.add(j)
        found.append({"t": a["t"], "tick": a["tick"], "k": "press", "x": a["x"], "y": a["y"], "z": a["z"]})
    return found


def main(argv):
    if len(argv) < 3:
        sys.exit(__doc__)
    src, dst = argv[1], argv[2]
    episode = int(argv[argv.index("--episode") + 1]) if "--episode" in argv else 1
    events = read(src)
    pr = presses(events)
    starts = [p for p in pr if (p["y"], p["z"]) == (121, 91)]
    # Episodes: start presses more than 60 s apart.
    groups = []
    for s in starts:
        if groups and s["t"] - groups[-1][-1]["t"] <= 60000:
            groups[-1].append(s)
        else:
            groups.append([s])
    if episode > len(groups):
        sys.exit(f"{src}: {len(groups)} Simon Says episode(s)")
    first = groups[episode - 1][0]["t"]
    done = next((e["t"] for e in events if e["k"] == "chat" and e["t"] > first), None)
    lo = first - 3000
    hi = (done + 2000) if done else groups[episode - 1][-1]["t"] + 60000
    keep = [e for e in events + pr if lo <= e["t"] <= hi]
    keep.sort(key=lambda e: (e["t"], 0 if e["k"] == "press" else 1))
    with gzip.open(dst, "wt") as f:
        for e in keep:
            e = {k: v for k, v in e.items() if k not in ("raw", "sec")}
            f.write(json.dumps(e, separators=(",", ":")) + "\n")
    print(f"{dst}: episode {episode}/{len(groups)}, {len(keep)} events, {sum(1 for e in keep if e['k'] == 'press')} presses")


if __name__ == "__main__":
    main(sys.argv)
