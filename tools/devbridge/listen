def client_table(clients):
    rows = ["%-8s %-20s %-10s %-10s %-4s %-30s %-6s %s" % ("PID", "INSTANCE", "SOUL", "BRIDGE", "API", "STATE / AREA", "PORT", "GAME DIR")]
    for c in clients:
        state = "disabled" if c.get("disabled") else "ok"
        if state == "ok":
            try:
                st = fetch_json(c, "/status", timeout=3)
                place = st.get("place") or {}
                state = "ok %s%s" % (place.get("area") or st.get("place", {}).get("server_id") or "-",
                                     (" / " + place["sub_location"]) if place.get("sub_location") else "")
                if st.get("failure"):
                    state = "FAILED"
            except (OSError, SystemExit, ValueError):
                state = "unreachable"
        rows.append("%-8s %-20s %-10s %-10s %-4s %-30s %-6s %s" % (c.get("pid"), (c.get("instance") or Path(c["_game"]).parent.name)[:20],
                                                                    c.get("soul_version") or "?", c.get("bridge_version") or "?",
                                                                    c.get("bridge_api") or "?", state[:30], c.get("port"), c["_game"]))
    return "\n".join(rows)


