def cmd_recompress(args):
    """gzip → zstd -12 (about 5× smaller, same content): the same pass the client runs after a recording stops."""
    for name in args.files:
        src = Path(name)
        if not src.name.endswith(".gz"):
            print("skip %s (not .gz)" % src)
            continue
        dst = src.with_name(src.name[:-3] + ".zst")
        part = dst.with_name(dst.name + ".part")
        t = time.time()
        try:
            from compression import zstd
            with gzip.open(src, "rb") as fin, zstd.open(part, "wb", level=12) as fout:
                while True:
                    chunk = fin.read(1 << 20)
                    if not chunk:
                        break
                    fout.write(chunk)
        except ImportError:
            with gzip.open(src, "rb") as fin, open(part, "wb") as fout:
                p = subprocess.Popen(["zstd", "-q", "-T2", "-12", "-c"], stdin=subprocess.PIPE, stdout=fout)
                shutil.copyfileobj(fin, p.stdin)
                p.stdin.close()
                if p.wait() != 0:
                    sys.exit("zstd failed on %s" % src)
        part.replace(dst)
        print("%s: %s → %s (%s, %.1fs)" % (src.name, mb(src.stat().st_size), mb(dst.stat().st_size), dst.name, time.time() - t))
        if args.rm:
            src.unlink()


