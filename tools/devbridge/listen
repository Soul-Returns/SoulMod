        args.arg = parts[1] if len(parts) > 1 else None
        if args.what in ("at", "track") and not args.arg:
            sys.exit("replay %s needs an argument" % args.what)
    {"status": cmd_status, "snapshot": cmd_snapshot, "listen": cmd_listen, "record": cmd_record, "mark": cmd_mark, "shot": cmd_shot,
     "log": cmd_log, "replay": cmd_replay, "marks": cmd_marks, "menus": cmd_menus, "recompress": cmd_recompress,
