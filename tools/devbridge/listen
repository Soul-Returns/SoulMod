import worldfile  # noqa: E402

COMPASS = ((0, "east (+x)"), (90, "south (+z)"), (180, "west (-x)"), (270, "north (-z)"))


def compass(dx, dz):
    import math
    ang = (math.degrees(math.atan2(dz, dx)) + 360) % 360
    return min(COMPASS, key=lambda c: min(abs(ang - c[0]), 360 - abs(ang - c[0])))[1]


def hole_regions(holes):
    """4-connected groups of [cx, cz] holes -> [(cols, (minx, minz, maxx, maxz))]."""
    left = {tuple(h) for h in holes}
    out = []
    while left:
        stack = [left.pop()]
        group = list(stack)
        while stack:
            x, z = stack.pop()
            for n in ((x + 1, z), (x - 1, z), (x, z + 1), (x, z - 1)):
                if n in left:
                    left.remove(n)
                    stack.append(n)
                    group.append(n)
        xs, zs = [g[0] for g in group], [g[1] for g in group]
        out.append((group, (min(xs), min(zs), max(xs), max(zs))))
    return out


def column_map(stored, seen, player=None, width_cap=120):
    """ASCII map of chunk columns: # captured, . hole (never seen), @ the player's column. x grows right, z down."""
    cx1, cx2, cz1, cz2 = stored[0] >> 4, stored[3] >> 4, stored[2] >> 4, stored[5] >> 4
    step = 1
    while (cx2 - cx1 + 1) // step > width_cap:
        step += 1
    lines = []
    lines.append("      x %d .. %d   (one char = %s chunk column%s of 16 blocks; # captured, . never seen%s)" % (
        cx1 * 16, cx2 * 16 + 15, step * step if step > 1 else 1, "s" if step > 1 else "", ", @ you" if player else ""))
    for z in range(cz1, cz2 + 1, step):
        row = []
        for x in range(cx1, cx2 + 1, step):
            cells = [(xx, zz) for xx in range(x, min(x + step, cx2 + 1)) for zz in range(z, min(z + step, cz2 + 1))]
            ch = "#" if all(c in seen for c in cells) else ("." if not any(c in seen for c in cells) else "+")
            if player and (player["cx"], player["cz"]) in cells:
                ch = "@"
            row.append(ch)
        lines.append("z%5d  %s" % (z * 16, "".join(row)))
    return lines


def seen_columns(stored, holes):
    cx1, cx2, cz1, cz2 = stored[0] >> 4, stored[3] >> 4, stored[2] >> 4, stored[5] >> 4
    hs = {tuple(h) for h in holes}
    return {(x, z) for x in range(cx1, cx2 + 1) for z in range(cz1, cz2 + 1)} - hs


def fmt_world_status(st):
    if not st.get("file"):
        return ["no world capture has run in this client session (`listen world start`)"]
    lines = []
    cols = st.get("columns") or {}
    b = st.get("bounds") or {}
    player = st.get("player")
    state = "CAPTURING" if st.get("active") else "ended (%s)" % st.get("reason", "stopped")
    lines.append("%s  %s%s" % (state, st["file"], ("  label %s" % st["label"]) if st.get("label") else ""))
    lines.append("dimension %s, %ss, bounds requested %s, stored %s" % (st.get("dimension"), st.get("seconds"), b.get("requested"), b.get("stored")))
    lines.append("columns %s/%s captured (%s queued, %s holes), %s sections, %s non-air blocks, %s states" % (
        cols.get("seen"), cols.get("total"), cols.get("queued"), cols.get("holes"), st.get("sections"), st.get("blocks_non_air"), st.get("states")))
    if b.get("covered"):
        lines.append("covered   %s" % b["covered"])
    lines.append("also      %s block entities (+%s updates), %s entities (+%s updates, %s capped), %s block changes (%s no-ops dropped), %s from re-sent chunks" % (
        st.get("block_entities"), st.get("block_entity_updates"), st.get("entities"), st.get("entity_updates"), st.get("entity_updates_capped"),
        st.get("changes"), st.get("changes_deduped"), st.get("diff_changes")))
    c = st.get("cost") or {}
    lines.append("file      %s gz (%s raw), writer queue %s, dropped %s" % (mb(st.get("bytes_gz") or 0), mb(st.get("bytes_raw") or 0), st.get("writer_queue"), st.get("dropped")))
    lines.append("cost      client thread avg %.3f ms/tick over %s ticks; %.2f ms/tick over the %s ticks that copied data; max %.2f ms; %s ticks over 2 ms (budget %s ms)" % (
        c.get("avg_ms") or 0, c.get("ticks"), c.get("avg_work_tick_ms") or 0, c.get("work_ticks"), c.get("max_ms") or 0, c.get("ticks_over_2ms"), c.get("budget_ms")))
    if st.get("entity_errors"):
        lines.append("entity errors %s, last: %s" % (st["entity_errors"], st.get("last_entity_error")))
    if st.get("failure"):
        lines.append("WRITER FAILED: %s" % st["failure"])
    if b.get("stored"):
        holes = st.get("holes") or []
        lines.append("")
        lines += column_map(b["stored"], seen_columns(b["stored"], holes), player if st.get("active") else None)
        if holes:
            regions = hole_regions(holes)
            if player and st.get("active"):
                px, pz = player["x"], player["z"]
                regions.sort(key=lambda r: (((r[1][0] + r[1][2] + 1) * 8 - px) ** 2 + ((r[1][1] + r[1][3] + 1) * 8 - pz) ** 2))
            lines.append("")
            lines.append("holes: %d chunk columns in %d region(s); walk until the chunks load, nearest first:" % (len(holes), len(regions)))
            for group, (x1, z1, x2, z2) in regions[:12]:
                cx, cz = (x1 + x2 + 1) * 8, (z1 + z2 + 1) * 8
                where = ""
                if player:
                    where = ", from you %d blocks %s" % (round(((cx - player["x"]) ** 2 + (cz - player["z"]) ** 2) ** 0.5), compass(cx - player["x"], cz - player["z"]))
                lines.append("  x %d..%d, z %d..%d  (%d columns; centre ≈ %d, %d%s)" % (x1 * 16, x2 * 16 + 15, z1 * 16, z2 * 16 + 15, len(group), cx, cz, where))
            if len(regions) > 12:
                lines.append("  … %d more regions" % (len(regions) - 12))
        else:
            lines.append("")
            lines.append("no holes: every chunk column inside the bounds was captured")
    if player and st.get("active"):
        lines.append("you are at x %.1f y %.1f z %.1f (chunk %d, %d)" % (player["x"], player["y"], player["z"], player["cx"], player["cz"]))
    return lines


