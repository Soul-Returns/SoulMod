from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
PRISM = Path.home() / ".local/share/PrismLauncher/instances"
LIVE = Path.home() / "live"   # the sandbox's view of the owner's game dirs (agent-vps via desk)


def live_or(path, name):
    return LIVE / name if not path.exists() and (LIVE / name).exists() else path


DEV_GAME = live_or(REPO / "run", "dev")
TEST_GAME = PRISM / "soulmod-test/minecraft"
SKYBLOCK_GAME = live_or(PRISM / "Hypixel Skyblock/minecraft", "skyblock")
POINTERS = Path.home() / ".cache/soul-devbridge/clients"
EVENTS_TABLE = Path(__file__).resolve().parent / "events.json"
COLOR = re.compile("§(#[0-9a-fA-F]{6}|.)|[\u200b\u2060]")   # color codes and the zero-width spaces some Hypixel/room names carry
STAMP = re.compile(r"^\d\d:\d\d:\d\d\.\d{3}( t\d+)? ")
OPTS = {"legacy": False, "inv": False, "full_lore": False}
PROVIDERS = ("self", "players", "entities", "map", "party", "world", "soul", "screen")


# ---------- discovery / connection ----------

def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True   # exists, but runs as another user (the sandbox watching the owner's client)
    except (OSError, ValueError, TypeError):
        return False


def candidate_dirs():
    dirs = [DEV_GAME, TEST_GAME, SKYBLOCK_GAME]
    dirs += [Path(p).parent.parent for p in glob.glob(str(PRISM / "*/minecraft/soul-dev/bridge.json"))]
    for f in glob.glob(str(POINTERS / "*.json")):
        try:
            dirs.append(Path(json.loads(Path(f).read_text())["game_dir"]))
        except (OSError, ValueError, KeyError):
            pass
    seen, out = set(), []
    for d in dirs:
        r = d.resolve()
        if r not in seen:
            seen.add(r)
            out.append(d)
    return out


def read_info(game):
    path = game / "soul-dev/bridge.json"
    try:
        info = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    info["_path"] = str(path)
    info["_game"] = str(game)
    return info


def live_clients():
    out = []
    for d in candidate_dirs():
        info = read_info(d)
        if info and alive(info.get("pid")):
            out.append(info)
    return out


def target_game(args):
    if args.game_dir:
        return Path(args.game_dir)
    if args.dev:
        return DEV_GAME
    if args.test:
        return TEST_GAME
    if args.skyblock:
        return SKYBLOCK_GAME
    if args.instance:
        return PRISM / args.instance / "minecraft"
    clients = live_clients()
    if args.pid:
        for c in clients:
            if int(c["pid"]) == args.pid:
                return Path(c["_game"])
        sys.exit("no running client with a bridge has pid %s" % args.pid)
    if len(clients) == 1:
        return Path(clients[0]["_game"])
    if not clients:
        sys.exit("no running client with the soul-devbridge mod (start one, or name a game dir for files: --dev/--test/--skyblock)")
    sys.exit("several clients run a bridge; pick one with --pid/--instance/--dev/--test/--skyblock:\n" + client_table(clients))


def bridge_info(game):
    info = read_info(game)
    if info is None:
        sys.exit("no %s/soul-dev/bridge.json: is a client with the soul-devbridge mod running?" % game)
    if not alive(info.get("pid")):
        sys.exit("stale %s: client pid %s is gone" % (info["_path"], info.get("pid")))
    return info


def request(info, target, timeout=10):
    sock = socket.create_connection(("127.0.0.1", int(info["port"])), timeout=timeout)
    sock.sendall(("GET %s HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Bearer %s\r\nConnection: close\r\n\r\n"
                  % (target, info["token"])).encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = sock.recv(65536)
        if not chunk:
            sys.exit("bridge closed the connection")
        buf += chunk
    head, rest = buf.split(b"\r\n\r\n", 1)
    status = head.split(b"\r\n", 1)[0].decode()
    if " 200 " not in status + " ":
        body = rest
        try:
            while True:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                body += chunk
        except OSError:
            pass
        sys.exit("bridge: %s %s" % (status, body.decode(errors="replace")))
    return sock, rest


def fetch_json(info, target, timeout=15):
    sock, body = request(info, target, timeout)
    while True:
        chunk = sock.recv(65536)
        if not chunk:
            break
        body += chunk
    sock.close()
    return local_paths(info, json.loads(body))


def local_paths(info, v):
    """Rebase paths under the client's reported game dir onto the game dir this CLI was given (a sandbox sees it mounted elsewhere)."""
    src, dst = info.get("game_dir"), info.get("_game")
    if not src or not dst or Path(src) == Path(dst):
        return v
    if isinstance(v, str):
        return str(Path(dst) / v[len(src):].lstrip("/")) if v == src or v.startswith(src.rstrip("/") + "/") else v
    if isinstance(v, list):
        return [local_paths(info, x) for x in v]
    if isinstance(v, dict):
        return {k: local_paths(info, x) for k, x in v.items()}
    return v


def query(**kw):
    q = {k: v for k, v in kw.items() if v not in (None, "", False)}
    return ("?" + urllib.parse.urlencode(q)) if q else ""


# ---------- formatting ----------

def txt(s):
    if s is None:
        return ""
    if not isinstance(s, str):
        s = str(s)
    return s if OPTS["legacy"] else COLOR.sub("", s)


def stamp(ms):
    return datetime.fromtimestamp(ms / 1000).strftime("%H:%M:%S.%f")[:-3]


def pos(p, digits=1):
    if not p:
        return "?"
    return "(%s)" % ", ".join("?" if v is None else ("%.*f" % (digits, v)) for v in p)


def item_str(item):
    if not isinstance(item, dict):
        return str(item)
    out = txt(item.get("name")) or "(no name)"
    if item.get("count", 1) != 1:
        out += " ×%d" % item["count"]
    out += "  " + (item.get("sb_id") or item.get("id", "?"))
    lore = [txt(l).strip() for l in item.get("lore", [])]
    lore = [l for l in lore if l]
    if lore and not OPTS["full_lore"]:
        lore = lore[:3] + (["…", lore[-1]] if len(lore) > 4 else lore[3:])
    if lore:
        out += "  — " + " | ".join(lore)
    if comps(item):
        out += "  " + comps(item)
    return out


def comps(item):
    """The bridge's compact component summary of an item (glint, model, custom model data, dye, enchantments, the component patch) on one line."""
    c = item.get("components") if isinstance(item, dict) else None
    if not c:
        return ""
    parts = []
    if c.get("glint"):
        parts.append("glint")
    if "glint_override" in c:
        parts.append("glint_override=%s" % str(c["glint_override"]).lower())
    for key in ("model", "dye", "tooltip_style"):
        if key in c:
            parts.append("%s=%s" % (key, c[key]))
    if "cmd" in c:
        parts.append("cmd=" + json.dumps(c["cmd"], separators=(",", ":")))
    if c.get("ench"):
        parts.append("ench=" + ",".join("%s %s" % (k.replace("minecraft:", ""), v) for k, v in c["ench"].items()))
    if c.get("unbreakable"):
        parts.append("unbreakable")
    if c.get("damage"):
        parts.append("damage=%s" % c["damage"])
    if c.get("patch"):
        parts.append("patch: " + ",".join(c["patch"]))
    return "{" + "; ".join(parts) + "}"


def brief(item):
    if not isinstance(item, dict):
        return "-"
    return "%s [%s]" % (txt(item.get("name")) or "?", item.get("sb_id") or item.get("id", "?"))


def slot_lines(slots, indent="    "):
    hidden, fillers, lines = 0, {}, []
    for s in slots:
        if s.get("player") and not OPTS["inv"]:
            hidden += 1
            continue
        it = s.get("item")
        # Hypixel pads menus with blank-named glass panes; panes that differ in components (a glint marks a clicked one) are counted apart
        if isinstance(it, dict) and not txt(it.get("name")).strip() and not it.get("lore"):
            fillers.setdefault((it.get("id"), comps(it)), []).append(s["slot"])
            continue
        lines.append("%s[%3d] %s" % (indent, s["slot"], item_str(it)))
    for (item_id, c), where in fillers.items():
        lines.append("%s(%d blank-named %s fillers%s)" % (indent, len(where), item_id, (" %s: slots %s" % (c, ",".join(map(str, where)))) if c else ""))
    if hidden:
        lines.append("%s(+%d player inventory items; --inv shows them)" % (indent, hidden))
    return lines


def fmt_self(d):
    if not isinstance(d, dict):
        return "self: none (not in a world)"
    look = d.get("looking_at") or {}
    looking = (" looking at %s %s" % (look.get("block") or look.get("entity"), look.get("pos"))) if look else ""
    room = d.get("room")
    return ("self: %s %s yaw %.1f pitch %.1f%s%s%s hp %s/%s held %s slot %s ping %s %s%s%s" % (
        d.get("name"), pos(d.get("pos"), 2), d.get("yaw") or 0, d.get("pitch") or 0,
        " ground" if d.get("on_ground") else " air", " sneak" if d.get("sneaking") else "", " sprint" if d.get("sprinting") else "",
        d.get("health"), d.get("max_health"), brief(d.get("held")), d.get("hotbar"), d.get("ping"), d.get("dimension"), looking,
        (" room %s" % txt(room.get("name") or room.get("type"))) if isinstance(room, dict) else ""))


def fmt_players(d):
    if not isinstance(d, dict):
        return ["players: none"]
    out = ["players: %d tracked" % d.get("count", 0)]
    for p in dicts(d.get("players")):
        out.append("    %-16s %s %s %5.1fm yaw %6.1f held %s%s since %s" % (
            p.get("name"), "real" if p.get("real") else "npc ", pos(p.get("pos")), p.get("distance") or 0, p.get("yaw") or 0,
            brief(p.get("held")), " sneak" if p.get("sneaking") else "", stamp(p["tracked_since"]) if p.get("tracked_since") else "?"))
    for u in dicts(d.get("untracked_recent")):
        out.append("    (untracked %s at %s, last %s)" % (u.get("name"), stamp(u["at"]), pos(u.get("last_pos"))))
    return out


def fmt_party(d):
    if not isinstance(d, dict):
        return ["party: none"]
    out = ["party: floor %s in_run %s leader %s" % (d.get("floor"), d.get("in_run"), d.get("leader"))]
    for m in dicts(d.get("members")):
        out.append("    %-16s %-8s %-6s %-6s %s%s" % (
            m.get("name"), m.get("class") or "-", "DEAD" if m.get("dead") else "", m.get("source"), pos(m.get("pos")),
            (" age %.1fs" % (m["age_ms"] / 1000)) if isinstance(m.get("age_ms"), (int, float)) else ""))
    return out


def fmt_world(d):
    if not isinstance(d, dict):
        return ["world: none"]
    loc = d.get("location") or {}
    out = ["world: %s | skyblock=%s area=%s sub=%s mode=%s server_id=%s profile=%s dim=%s" % (
        d.get("server"), loc.get("on_skyblock"), loc.get("area"), loc.get("sub_location"), loc.get("mode"), loc.get("server_id"),
        loc.get("profile"), d.get("dimension"))]
    sb = d.get("sidebar")
    if sb:
        out.append("    sidebar: %s" % txt(sb.get("title")))
        out += ["      " + txt(l) for l in sb.get("lines", [])]
    tab = d.get("tab")
    if tab:
        lines = [txt(l).strip() for l in tab.get("lines", [])]
        out.append("    tab: %d lines (%d non-empty)" % (len(lines), len([l for l in lines if l])))
    if d.get("action_bar"):
        out.append("    action bar: " + txt(d["action_bar"]))
    if d.get("title"):
        out.append("    title: %s | %s" % (txt(d["title"].get("title")), txt(d["title"].get("subtitle"))))
    for b in d.get("boss_bars", []):
        out.append("    boss bar: %s %.2f %s" % (txt(b.get("name")), b.get("progress") or 0, b.get("color")))
    return out


def fmt_entities(d):
    if not isinstance(d, dict):
        return ["entities: none"]
    out = ["entities: %s matched, %s shown (%s)" % (d.get("matched"), d.get("shown"), d.get("query"))]
    for e in d.get("entities", []):
        out.append("    %-24s #%-8s %5.1fm %s %s%s" % (e.get("type"), e.get("id"), e.get("distance") or 0, pos(e.get("pos")), txt(e.get("name")),
                                                  ("  head " + brief(e["head"])) if e.get("head") else ""))
    return out


def fmt_map(d):
    if not isinstance(d, dict) or not d.get("markers"):
        return ["map: no dungeon map%s" % ("" if not isinstance(d, dict) else "")]
    out = ["map: id %s floor %s dims %s (%s)" % (d.get("map_id"), d.get("floor"), d.get("dims_known"), d.get("limit"))]
    for m in d["markers"]:
        out.append("    %s%s map(%s,%s) yaw %.1f world %s" % (m.get("type"), " (self)" if m.get("self") else "", m.get("map_x"), m.get("map_y"),
                                                       m.get("yaw") or 0, pos([m.get("x"), None, m.get("z")])))
    return out


def fmt_soul(d, width=400):
    if not isinstance(d, dict):
        return ["soul: none"]
    out = ["soul: " + ", ".join(d.keys())]
    for k, v in d.items():
        s = json.dumps(v, ensure_ascii=False)
        out.append("    %s: %s" % (k, s if len(s) <= width else s[:width] + "…"))
    return out


def fmt_screen(sc):
    if sc is None:
        return ["screen: none"]
    out = ['screen: %s "%s" #%s %s %s+%s slots' % (sc["class"], txt(sc.get("title")), sc.get("container_id"), sc.get("menu_type"),
                                                  sc.get("container_slots"), (sc.get("slot_count") or 0) - (sc.get("container_slots") or 0))]
    if sc.get("carried"):
        out.append("    carried: " + item_str(sc["carried"]))
    return out + slot_lines(sc.get("slots", []))


def fmt_snapshot(snap):
    ticks = snap.get("ticks") or {}
    out = ["%s on %s | server tick %s (%s/s, source %s), pings %s (%s/s, diagnostic)" % (
        snap.get("player"), snap.get("server"), ticks.get("tick"), ("%.2f" % ticks["tick_rate"]) if ticks.get("tick_rate") else "-", ticks.get("source"),
        ticks.get("pings"), ("%.1f" % ticks["ping_rate"]) if ticks.get("ping_rate") else "-")]
    if "self" in snap:
        out.append(fmt_self(snap["self"]))
    if "players" in snap:
        out += fmt_players(snap["players"])
    if "party" in snap:
        out += fmt_party(snap["party"])
    if "map" in snap:
        out += fmt_map(snap["map"])
    if "world" in snap:
        out += fmt_world(snap["world"])
    if "entities" in snap:
        out += fmt_entities(snap["entities"])
    if "soul" in snap:
        out += fmt_soul(snap["soul"])
    if "screen" in snap:
        out += fmt_screen(snap["screen"])
    return out


def fmt(ev):
    """One or more display lines for an event; data this tool does not understand (another server, a newer bridge) prints raw instead of raising."""
    try:
        return fmt_event(ev)
    except UNEXPECTED:
        return ["%s %s <unrecognised data> %s" % (stamp(ev["t"]) if isinstance(ev.get("t"), (int, float)) else "?", (ev.get("kind") or "?").upper(),
                                                   json.dumps(ev.get("data"), ensure_ascii=False, default=str)[:300])]


UNEXPECTED = (AttributeError, TypeError, KeyError, ValueError, IndexError)


def dicts(v):
    """The dict items of a list; anything else (a string, null, a number) is an empty list."""
    return [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []


def fmt_event(ev):
    k, d, t = ev.get("kind"), ev.get("data"), stamp(ev.get("t", time.time() * 1000))
    tick = ev.get("tick")
    t = t + (" t%s" % tick if tick is not None else "")
    d0 = d if isinstance(d, dict) else {}
    cid = "#%s" % d0.get("container_id")
    if k == "hello":
        f = d0.get("filter", {})
        return ["%s LISTENING kinds=%s%s%s" % (t, ",".join(f.get("kinds", [])),
                                               "".join(" %s=%s" % (x, ",".join(f[x])) for x in ("types", "channels") if f.get(x)),
                                               (" state=" + ",".join(f["state"])) if f.get("state") else "")]
    if k == "snapshot":
        return ["%s SNAPSHOT" % t] + ["    " + l for l in fmt_snapshot(d0)]
    if k == "backlog":
        return ["%s BACKLOG %s earlier events follow" % (t, d0.get("events"))]
    if k == "self":
        return ["%s %s" % (t, fmt_self(d))]
    if k == "players":
        return ["%s %s" % (t, l) for l in fmt_players(d)[:1]] + fmt_players(d)[1:]
    if k == "party":
        return ["%s %s" % (t, fmt_party(d)[0])] + fmt_party(d)[1:]
    if k == "world":
        return ["%s %s" % (t, fmt_world(d)[0])] + fmt_world(d)[1:]
    if k == "entities":
        return ["%s %s" % (t, fmt_entities(d)[0])] + fmt_entities(d)[1:]
    if k == "map":
        return ["%s %s" % (t, fmt_map(d)[0])] + fmt_map(d)[1:]
    if k == "soul":
        return ["%s %s" % (t, fmt_soul(d)[0])] + fmt_soul(d)[1:]
    if k == "screen":
        return ["%s %s" % (t, fmt_screen(d)[0])] + fmt_screen(d)[1:]
    if k == "mark":
        return ["%s MARK %s: %s at %s yaw %.1f pitch %.1f looking at %s held %s area %s" % (
            t, d0.get("n"), d0.get("label"), pos(d0.get("pos"), 2), d0.get("yaw") or 0, d0.get("pitch") or 0,
            (d0.get("looking_at") or {}).get("block") or (d0.get("looking_at") or {}).get("entity"), brief(d0.get("held")),
            (d0.get("location") or {}).get("area"))]
    if k == "title":
        if d0.get("type") == "times":
            return ["%s TITLE times fade in %s, stay %s, fade out %s ticks" % (t, d0.get("fade_in"), d0.get("stay"), d0.get("fade_out"))]
        return ["%s TITLE %s %s" % (t, d0.get("type"), txt(d0.get("text")))]
    if k == "bossbar":
        return ["%s BOSSBAR %s %s %s" % (t, d0.get("op"), txt(d0.get("name")), d0.get("progress", ""))]
    if k == "location":
        return ["%s LOCATION area=%s sub=%s mode=%s server=%s" % (t, d0.get("area"), d0.get("sub_location"), d0.get("mode"), d0.get("server_id"))]
    if k == "connection":
        return ["%s CONNECTION %s %s" % (t, d0.get("op"), d0.get("server") or "")]
    if k == "tracking":
        return ["%s TRACKING %s %s %s %s" % (t, d0.get("event"), d0.get("name"), "real" if d0.get("real") else "", pos(d0.get("pos") or d0.get("last_pos")))]
    if k == "record":
        if d0.get("op"):
            return ["%s RECORD %s #%s %s%s" % (t, d0["op"], d0.get("id"), d0.get("file"), (" (%s)" % d0["reason"]) if d0.get("reason") else "")]
        return ["%s RECORD %s %s %ss %s lines %s bytes gz" % (t, ("stopped: " + d0["stopped"]) if d0.get("stopped") else "running", d0.get("file"),
                                                           d0.get("seconds"), d0.get("lines"), d0.get("compressed_bytes"))]
    if k == "screenshot":
        return ["%s SCREENSHOT %s" % (t, d0.get("file"))]
    if k == "screen_open":
        return ['%s OPEN %s "%s" %s %s+%s slots' % (t, cid, txt(d0.get("title")), d0.get("menu_type"), d0.get("container_slots", "?"),
                                                    (d0["slot_count"] - d0["container_slots"]) if "slot_count" in d0 and "container_slots" in d0 else "?")]
    if k in ("screen_contents", "inventory_contents"):
        label = "CONTENTS" if k == "screen_contents" else "INV_CONTENTS"
        return ['%s %s %s "%s" %d slots, %d filled' % (t, label, cid, txt(d0.get("title")), d0.get("slot_count", 0), len(d0.get("slots", [])))] \
            + slot_lines(d0.get("slots", []))
    if k in ("slot_update", "inventory_slot"):
        if d0.get("player") and k == "slot_update" and not OPTS["inv"]:
            return []
        return ["%s %s %s [%3d] %s" % (t, "SLOT" if k == "slot_update" else "INV_SLOT", cid, d0.get("slot", -1), item_str(d0.get("item")))]
    if k == "page":
        return ['%s PAGE "%s" (#%s) -> "%s" (#%s)%s' % (t, txt(d0.get("from_title")), d0.get("from_container_id"), txt(d0.get("title")),
                                                       d0.get("container_id"), " same container" if d0.get("same_container") else "")]
    if k == "screen_close":
        return ['%s CLOSE %s "%s" by %s' % (t, cid, txt(d0.get("title")), d0.get("by"))]
    if k == "click":
        it = d0.get("item")
        return ['%s CLICK %s [%d] %s button %s on "%s": %s' % (t, cid, d0.get("slot", -1), d0.get("input"), d0.get("button"),
                                                              txt(d0.get("title")), item_str(it) if isinstance(it, dict) else it)]
    if k in ("chat", "actionbar"):
        out = ["%s %s %s" % (t, k.upper(), txt(d0.get("text")))]
        for hover in d0.get("hover", []):
            out += ["    hover: " + line for line in txt(hover).split("\n")]
        return out
    if k == "sidebar":
        return ["%s SIDEBAR %s" % (t, txt(d0.get("title")))] + ["    " + txt(l) for l in d0.get("lines", [])]
    if k == "tab":
        lines = [txt(l).strip() for l in d0.get("lines", [])]
        return ["%s TAB %d lines" % (t, len(lines))] + ["    " + l for l in lines if l]
    if k == "packet":
        body = json.dumps(d0.get("data"), ensure_ascii=False)
        return ["%s PACKET %s %s%s%s %s" % (t, d0.get("dir"), d0.get("type"), (" #%s" % d0["seq"]) if d0.get("seq") else "",
                                           " " + d0["channel"] if d0.get("channel") else "", body if len(body) <= 400 else body[:400] + "…")]
    if k == "held":
        return ["%s HELD %s slot %s%s %s" % (t, d0.get("op"), d0.get("slot"), (" (from %s)" % d0["from"]) if d0.get("from") is not None else "", brief(d0.get("item")) if d0.get("item") else "empty hand")]
    if k == "bridge":
        return ["%s BRIDGE %s %s: %s" % (t, d0.get("op"), d0.get("type") or "", d0.get("reason"))]
    if k == "dropped":
        return ["%s DROPPED %s events (total %s): the stream fell behind" % (t, d0.get("count"), d0.get("total"))]
    return ["%s %s %s" % (t, (k or "?").upper(), json.dumps(d, ensure_ascii=False)[:400])]


