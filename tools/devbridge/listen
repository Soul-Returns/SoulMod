# ---------- recordings ----------
#
# A recording is a gzip (while it grows) or zstd (after the client's compression pass) NDJSON file;
# a 3 h session is ~3 GB raw. Everything here streams: one pass, constant memory, and a line is
# JSON-parsed only when its kind (read from the line's fixed prefix) and time are wanted.

PRE = re.compile(rb'^\{"t":(-?\d+),"tick":([^,]*),"(?:gt|ping)":([^,]*),"kind":"(\w+)"')


def pre_clock(m):
    """(clock, ping) of a PRE match. v2 lines are `tick` (the clock) then `ping`; v1 lines `tick` (the ping count) then `gt` (the clock then)."""
    a = None if m.group(2) == b"null" else int(m.group(2))
    b = None if m.group(3) == b"null" else int(m.group(3))
    return (b, a) if b'"gt":' in m.group(0) else (a, b)


PKT = re.compile(rb'"type":"(?:minecraft:)?(\w+)"')
DEFAULT_LIMIT = 300
TIMELINE_KINDS = {"chat", "title", "bossbar", "location", "connection", "mark", "screen_open", "screen_close", "page", "record", "end"}
GREP_KINDS = {"chat", "title", "actionbar", "bossbar", "screen_open", "click", "mark"}


def zstd_errors():
    try:
        from compression import zstd
        return (zstd.ZstdError,)
    except ImportError:
        return ()


def open_stream(path):
    name = Path(path).name
    if name.endswith(".zst"):
        try:
            from compression import zstd
            return zstd.open(path, "rb")
        except ImportError:
            return subprocess.Popen(["zstd", "-dc", str(path)], stdout=subprocess.PIPE).stdout
    if name.endswith(".gz"):
        return gzip.open(path, "rb")
    return open(path, "rb")


def lines(path):
    """Raw lines of a recording or capture; one still being written (or cut off) ends early, cleanly.
    A recording the client finished compressing a moment ago (`.gz` replaced by `.zst`) is opened under its new name."""
    f = open_stream(settle(path))
    try:
        yield from f
    except (EOFError, zlib.error, OSError) + zstd_errors():
        pass
    finally:
        f.close()


def settle(path):
    """The file to read now: `path`, or its twin when the client's recompression swapped `.gz` for `.zst` underneath us."""
    path = Path(path)
    if path.exists():
        return path
    name = path.name
    for old, new in ((".gz", ".zst"), (".zst", ".gz")):
        if name.endswith(old):
            twin = path.with_name(name[: -len(old)] + new)
            if twin.exists():
                return twin
    return path


def disk_size(path):
    """Bytes on disk of a recording, whichever of its two names exists now (0 when neither: it was removed)."""
    try:
        return settle(path).stat().st_size
    except OSError:
        return 0


def scan(path, kinds=None, t_from=None, t_to=None, needle=None):
    """(kind, t_ms, raw line) for lines of the wanted kinds/time range; `needle` = bytes the line must contain."""
    for line in lines(path):
        if needle is not None and needle not in line:
            continue
        m = PRE.match(line)
        if m:
            k, t = m.group(4).decode(), int(m.group(1))
        else:  # a capture or older writer with another key order
            try:
                o = json.loads(line)
            except ValueError:
                continue
            k, t = o.get("kind"), o.get("t")
            if k is None or t is None:
                continue
        if kinds is not None and k not in kinds:
            continue
        if (t_from is not None and t < t_from) or (t_to is not None and t > t_to):
            continue
        yield k, t, line


def stamps(line):
    """(clock, ping) of a recording line: the server tick to use, and the raw ping count (diagnostic)."""
    m = PRE.match(line)
    if not m:
        return line_clock(event(line))
    return pre_clock(m)


def line_clock(o):
    if "gt" in o:  # format v1: `tick` was the ping count, `gt` the client's game time (the clock back then)
        return o.get("gt"), o.get("tick")
    return o.get("tick"), o.get("ping")


def event(line):
    """A parsed recording line, normalised to the v2 meaning: `tick` = the clock, `ping` = the raw ping count (v1 `gt` becomes `tick`).
    A line cut off mid-write (a recording still being written, or a crash) comes back as an empty `corrupt` event instead of raising."""
    try:
        o = json.loads(line)
    except ValueError:
        return {"t": 0, "tick": None, "ping": None, "kind": "corrupt", "data": {}}
    if isinstance(o, dict) and "gt" in o:
        o["tick"], o["ping"] = line_clock(o)
        del o["gt"]
    return o


def read_events(path):
    """Every parsed line of a small file (marks.ndjson, a short capture)."""
    out = []
    for line in lines(path):
        e = event(line)
        if e.get("kind") != "corrupt":
            out.append(e)
    return out


def disk_mtime(path):
    """Modification time of a file that may be replaced by its twin (`.gz` → `.zst`) at any moment; 0 when it is gone."""
    try:
        return settle(path).resolve().stat().st_mtime
    except OSError:
        return 0


def latest_recording(game):
    d = game / "soul-dev/recordings"
    found = [p for p in d.glob("latest.rec.ndjson.*") if p.exists()]
    if not found:
        found = [p for p in d.glob("*.rec.ndjson.*") if not p.name.endswith(".part")]
    if not found:
        sys.exit("no recording in %s" % d)
    return max(found, key=disk_mtime).resolve()


def recording_path(args):
    if getattr(args, "file", None):
        p = settle(args.file)
        if not p.exists():
            sys.exit("no such file %s" % args.file)
        return p
    return latest_recording(target_game(args))


def first_event(path):
    g = lines(path)
    try:
        for line in g:
            try:
                return json.loads(line)
            except ValueError:
                continue
    finally:
        g.close()
    return None


def load_rules():
    rules = []
    for r in json.loads(EVENTS_TABLE.read_text()).get("rules", []):
        rules.append((r["name"], set(r.get("on", ["chat"])), re.compile(r["match"])))
    return rules


def flat(text):
    """One display line for a multi-line chat message."""
    return re.sub(r"\s*\n\s*", " | ", text.strip()) if text else ""


def text_of(ev):
    """The searchable text of an event (colors stripped), '' for kinds without one."""
    k, d = ev.get("kind"), data_of(ev)
    if k == "title" and d.get("type") == "times":
        return "times: fade in %s, stay %s, fade out %s ticks" % (d.get("fade_in"), d.get("stay"), d.get("fade_out"))
    if k in ("chat", "title", "actionbar"):
        text = ev.get("data") if isinstance(ev.get("data"), str) else d.get("text")
        return COLOR.sub("", sval(text))
    if k == "bossbar":
        return COLOR.sub("", sval(d.get("name")))
    if k == "screen_open":
        return COLOR.sub("", sval(d.get("title")))
    if k == "click":
        it = d.get("item")
        return COLOR.sub("", sval(it.get("name"))) if isinstance(it, dict) else ""
    if k == "mark":
        return sval(d.get("label"))
    if k == "tracking":
        return sval(d.get("name"))
    return ""


def data_of(ev):
    """The event's data as a dict: odd servers and builds send strings, lists or null where the rules expect an object."""
    d = ev.get("data")
    return d if isinstance(d, dict) else {}


def sval(v):
    return v if isinstance(v, str) else ("" if v is None else str(v))


def classify(ev, rules):
    k, d = ev.get("kind"), data_of(ev)
    if k == "bossbar" and d.get("op") not in ("add", "name"):
        return None, None
    if k not in ("chat", "title", "bossbar"):
        return None, None
    text = text_of(ev)
    for name, on, rx in rules:
        if k in on and rx.search(text):
            return name, flat(text)
    return None, flat(text)


def rel(ms, t0):
    """Seconds from the recording start; backlog events from before it come out negative."""
    s = (ms - t0) / 1000
    sign, s = ("-", -s) if s < 0 else ("+", s)
    return "%s%02d:%04.1f" % (sign, int(s // 60), s % 60)


TICK_WINDOW = 200  # `tick=N` takes the first line at/after the recording start whose tick is in [N, N+200): another server's game time is far away


def when_ms(spec, path, t0):
    """+SECS, +MM:SS, MM:SS, HH:MM:SS (wall clock), tick=N (the server tick, `gt=N` is the same), ping=N (raw ping count) → epoch ms of the first line at or after it."""
    if spec.startswith(("tick=", "gt=", "ping=")):
        key, n = spec.split("=", 1)
        n = int(n)
        last = t0
        for line in lines(path):
            m = PRE.match(line)
            if not m:
                continue
            last = int(m.group(1))
            clock, ping = pre_clock(m)
            value = ping if key == "ping" else clock
            if value is not None and n <= value < n + TICK_WINDOW and last >= t0 and m.group(4) != b"backlog":
                return last
        return last
    if re.fullmatch(r"\d\d:\d\d:\d\d(\.\d+)?", spec):
        day = datetime.fromtimestamp(t0 / 1000)
        h, m, s = spec.split(":")
        return day.replace(hour=int(h), minute=int(m), second=int(float(s)), microsecond=int((float(s) % 1) * 1e6)).timestamp() * 1000
    s = spec.lstrip("+")
    if ":" in s:
        mm, ss = s.split(":")
        return t0 + (int(mm) * 60 + float(ss)) * 1000
    return t0 + float(s) * 1000


class Range:
    """--from/--to of a replay-like command, resolved against the recording start."""

    def __init__(self, args, path):
        head = first_event(path) or {}
        self.head = head.get("data") or {}
        self.t0 = head.get("t") or 0
        f, t = getattr(args, "from_", None), getattr(args, "to", None)
        self.t_from = when_ms(f, path, self.t0) if f else None
        self.t_to = when_ms(t, path, self.t0) if t else None

    def scan(self, path, kinds=None, needle=None):
        return scan(path, kinds, self.t_from, self.t_to, needle)


class Limited:
    """Bounded output: the first (or with --tail the last) `limit` lines, then one footer naming how to narrow."""

    def __init__(self, args, default=DEFAULT_LIMIT):
        n = getattr(args, "limit", None)
        self.limit = default if n is None else n
        self.tail = getattr(args, "tail", False)
        self.rows = collections.deque(maxlen=self.limit if (self.tail and self.limit) else None)
        self.total = 0

    def add(self, row):
        self.total += 1
        if self.limit and not self.tail and self.total > self.limit:
            return
        self.rows.append(row)

    def flush(self, what="lines", hint="--from/--to, --kinds, --grep, --player, or --limit 0"):
        for r in self.rows:
            print(r)
        if self.limit and self.total > self.limit:
            print("… %d %s %s (%d shown); narrow with %s" % (self.total - self.limit, what, "before" if self.tail else "more", self.limit, hint))


def cmd_replay(args):
    path = recording_path(args)
    rng = Range(args, path)
    if not rng.head:
        sys.exit("empty recording %s" % path)
    {"summary": replay_summary, "timeline": replay_timeline, "at": replay_at, "track": replay_track, "ticks": replay_ticks,
     "sizes": replay_sizes}[args.what](args, path, rng)


def mb(n):
    return "%.1f MB" % (n / 1e6)


def replay_summary(args, path, rng):
    t0, head = rng.t0, rng.head
    client = head.get("client") or {}
    rules = load_rules()
    parse_kinds = {"chat", "title", "bossbar", "location", "connection", "mark", "screen_open", "tracking", "end"}
    kinds, kind_bytes, t_last = collections.Counter(), collections.Counter(), t0
    pdirs = collections.Counter()
    ticks, gts = [None, None], [None, None]
    places, evs, marks, menus = [], [], [], collections.Counter()
    real, npc, joins, end = {}, collections.Counter(), [], None
    for line in lines(path):
        m = PRE.match(line)
        if not m:
            continue
        k = m.group(4).decode()
        kinds[k] += 1
        kind_bytes[k] += len(line)
        if k == "packet":
            pdirs["out" if b'"dir":"out"' in line[:200] else "in"] += 1
        t = int(m.group(1))
        if k != "backlog" and t > t_last:
            t_last = t
        clock, ping = pre_clock(m)
        if clock is not None:
            ticks[0] = ticks[0] if ticks[0] is not None else clock
            ticks[1] = clock
        if ping is not None and k in PROVIDERS:
            gts[0] = gts[0] if gts[0] is not None else ping
            gts[1] = ping
        if k not in parse_kinds:
            continue
        if k == "tracking" and b'"real":true' not in line and b'"event":"tracked"' not in line:
            continue
        e = event(line)
        d = e.get("data")
        if not isinstance(d, dict):
            d = {}
        if k == "location":
            p = (d.get("area"), d.get("sub_location"), d.get("server_id"))
            if p[0] and p[1] and (not places or places[-1][1] != p):
                places.append((t, p))
        elif k == "connection" and d.get("op") == "join":
            joins.append(t)
        elif k == "tracking":
            name = COLOR.sub("", d.get("name") or "")
            if d.get("real"):
                s = real.setdefault(name, [t, t, 0])
                s[1], s[2] = t, s[2] + 1
            else:
                npc[name] += 1
        elif k == "mark":
            marks.append(e)
        elif k == "screen_open":
            menus[txt(d.get("title"))] += 1
        elif k == "end":
            end = d
        elif k in ("chat", "title", "bossbar"):
            name, text = classify(e, rules)
            if name:
                evs.append((t, name, text))
    size = disk_size(path)
    raw = sum(kind_bytes.values())
    print("%s (%s on disk, %s raw, format %s v%s)" % (path, mb(size), mb(raw), head.get("format"), head.get("version")))
    print("player %s on %s, Soul %s, bridge %s, instance %s" % (head.get("player"), head.get("server"), client.get("soul_version"),
                                                                 client.get("bridge_version"), client.get("instance")))
    print("duration %.1fs (%s → %s), %d lines, %d server joins; server tick %s; ping count %s" % (
        (t_last - t0) / 1000, stamp(t0), stamp(t_last), sum(kinds.values()), len(joins),
        ("%s..%s (%s)" % (ticks[0], ticks[1], "game time from set_time, interpolated: the clock to use" if (head.get("version") or 1) >= 2 else "format v1: the client's game time, snapped to set_time; its `tick` was the ping count")) if ticks[0] is not None else "none (no set_time seen)",
        ("%s..%s (diagnostic; `replay ticks` compares it with the clock)" % tuple(gts)) if gts[0] is not None else "-"))
    top = kinds.most_common()
    print("kinds   " + ", ".join("%s %d (%s)" % (k, n, mb(kind_bytes[k])) for k, n in top[:14]) + ((", +%d more kinds (`replay sizes`)" % (len(top) - 14)) if len(top) > 14 else ""))
    if pdirs:
        asked = (head.get("filter") or {}).get("dir")
        print("packets in %d, out %d%s" % (pdirs["in"], pdirs["out"], ("  <- the recording asked for dir=%s but has no outbound packets (recorded by a bridge older than 2026-11-12, or an old preset: use --dir both with a current bridge)" % asked) if asked in ("out", "both") and not pdirs["out"] else ""))
    shown = places[:40]
    print("places  " + ("; ".join("%s %s / %s (%s)" % (rel(t, t0), a, s, sid) for t, (a, s, sid) in shown) or "-") + ((" … +%d more" % (len(places) - 40)) if len(places) > 40 else ""))
    if real:
        print("players real (tracked as entities): " + ", ".join("%s %s..%s" % (n, rel(s[0], t0), rel(s[1], t0)) for n, s in list(real.items())[:30])
              + ((" … +%d more" % (len(real) - 30)) if len(real) > 30 else ""))
    if npc:
        print("        npc entities tracked: %d (%d distinct names; most: %s)" % (sum(npc.values()), len(npc), ", ".join("%s ×%d" % kv for kv in npc.most_common(5))))
    found = collections.OrderedDict()
    for t, name, _ in evs:
        found.setdefault(name, []).append(t)
    print("events  " + (", ".join("%s ×%d (first %s)" % (n, len(ts), rel(ts[0], t0)) for n, ts in found.items()) or "none classified"))
    runs = dungeon_runs(evs)
    if runs:
        print("runs    %d" % len(runs))
        for i, r in enumerate(runs, 1):
            print("   #%d %s start %s%s%s end %s  %s  deaths %s own secrets %s" % (
                i, r.get("floor") or "?", rel(r["start"], t0), (" blood door %s" % rel(r["blood"], t0)) if r.get("blood") else "",
                (" boss %s" % rel(r["boss"], t0)) if r.get("boss") else "", rel(r["end"], t0) if r.get("end") else "(no end)",
                " ".join(x for x in (r.get("score"), r.get("defeated")) if x) or "-", r.get("deaths"), r.get("secrets", "?")))
    print("marks   %d" % len(marks))
    for m in marks:
        d = m["data"]
        print("   %s #%s %-24s %s yaw %.1f %s" % (rel(m["t"], t0), d.get("n"), d.get("label"), pos(d.get("pos"), 2), d.get("yaw") or 0,
                                                 (d.get("location") or {}).get("area")))
    if menus:
        top = menus.most_common()
        print("menus   %d opened: %s%s" % (sum(menus.values()), ", ".join('"%s" ×%d' % kv for kv in top[:30]), (" … +%d more titles" % (len(top) - 30)) if len(top) > 30 else ""))
    if end:
        print("end     %s; dropped %s, queue drops %s, caps %s" % (end.get("reason"), end.get("dropped") or "nothing", end.get("queue_dropped"), end.get("caps")))
        if end.get("next"):
            print("        continues in %s" % end["next"])
    else:
        print("end     (no end line: still recording or cut off)")


def dungeon_runs(evs):
    """One row per dungeon run from the named chat events: floor, start, blood door, boss entry, end, score, boss time, deaths, secrets."""
    runs, cur = [], None
    for t, name, text in evs:
        if name == "run start":
            cur = {"start": t, "deaths": 0}
            runs.append(cur)
        elif cur is None:
            continue
        elif name == "death":
            cur["deaths"] += 1
        elif name == "blood open":
            cur.setdefault("blood", t)
        elif name.startswith("boss entry"):
            cur.setdefault("boss", t)
        elif name == "run floor":
            cur.setdefault("floor", ("MM " if "Master Mode" in text else "") + re.sub(r"^.*Catacombs - ", "", text.strip()))
        elif name == "score":
            cur.setdefault("score", text.strip().replace("Team Score: ", "score "))
        elif name == "defeated":
            cur.setdefault("defeated", re.sub(r"^.*Defeated ", "", text.strip()))
        elif name == "stat secrets":
            cur.setdefault("secrets", re.sub(r"\D", "", text))
        elif name == "run end":
            cur.setdefault("end", t)
    return runs


def replay_timeline(args, path, rng):
    rules = load_rules()
    t0 = rng.t0
    wanted = set(args.kinds.split(",")) if args.kinds else None
    if args.all or (wanted and "all" in wanted):
        wanted = None
    elif wanted is None:
        wanted = GREP_KINDS if args.grep else TIMELINE_KINDS
    grep = re.compile(args.grep, re.I) if args.grep else None
    needle = args.player.encode() if args.player else None
    out_ = Limited(args)
    for k, t, line in rng.scan(path, wanted, needle):
        if k in ("header", "snapshot", "backlog") and not (wanted and k in wanted):
            continue
        e = event(line)
        if e.get("kind") == "corrupt":
            continue
        d = e.get("data")
        if not isinstance(d, dict):
            d = {}
        if k == "bossbar" and d.get("op") == "progress" and not (args.kinds and "bossbar" in args.kinds.split(",")):
            continue
        if grep and not grep.search(text_of(e)):
            continue
        name, text = classify(e, rules)
        if args.events and not name:
            continue
        tick = e.get("tick") if e.get("tick") is not None else "-"
        prefix = "%s %-10s" % (rel(t, t0), tick)
        if name:
            out_.add("%s EVENT %-22s %s" % (prefix, name, text))
        elif k in ("chat", "actionbar", "title"):
            out_.add("%s %-8s %s" % (prefix, k.upper(), flat(text_of(e)) if not OPTS["legacy"] else flat(d.get("text") or "")))
        else:
            for i, l in enumerate(fmt(e)):
                out_.add(("%s %s" % (prefix, STAMP.sub("", l, count=1))) if i == 0 else l)
    out_.flush("lines")


def reconstruct(path, rng, until):
    last, snap, chat, screen, extra = {}, None, collections.deque(maxlen=8), None, {}
    kinds = set(PROVIDERS) | {"snapshot", "chat", "screen_open", "screen_close", "mark", "title"}
    last_clock = None
    for k, t, line in scan(path, kinds, None, until):
        c = stamps(line)[0]
        if c is not None and k != "snapshot":
            last_clock = (t, c)
        if k == "snapshot":
            snap = (t, line)
        elif k in PROVIDERS:
            last[k] = (t, line)
        elif k == "chat":
            chat.append((t, line))
        elif k == "screen_open":
            screen = (t, line)
        elif k == "screen_close":
            screen = None
        else:
            extra["last_" + k] = (t, line)
    state = {}
    if snap:
        sd = event(snap[1]).get("data") or {}
        for p in PROVIDERS:
            if p in sd:
                state[p] = (snap[0], sd[p])
    for p, (t, line) in last.items():
        if p not in state or t >= state[p][0]:
            state[p] = (t, event(line).get("data"))
    state["chat"] = [(t, (event(l).get("data") or {}).get("text") if isinstance(event(l).get("data"), dict) else None) for t, l in chat]
    state["menu"] = (screen[0], event(screen[1]).get("data") or {}) if screen else None
    for k, (t, line) in extra.items():
        state[k] = (t, event(line).get("data"))
    if last_clock is not None:
        state["_tick"] = last_clock
    return state


def replay_at(args, path, rng):
    t0 = rng.t0
    when = when_ms(args.arg, path, t0)
    st = reconstruct(path, rng, when)
    if args.json:
        return print(json.dumps({k: v for k, v in st.items()}, ensure_ascii=False, indent=1, default=str))
    tick = st.get("_tick")
    print("at %s (%s%s)" % (rel(when, t0), stamp(when), (", server tick %s" % tick[1]) if tick else ""))
    limit = args.limit if args.limit is not None else 30
    for p in ("self", "players", "party", "map", "world", "entities", "soul", "screen"):
        if p not in st:
            continue
        t, d = st[p]
        try:
            if p == "players" and isinstance(d, dict):
                d = dict(d)
                ps = sorted(dicts(d.get("players")), key=lambda x: (not x.get("real"), x.get("distance") or 0))
                extra = max(0, len(ps) - limit) if limit else 0
                d["players"] = ps[:limit] if limit else ps
                gone = dicts(d.get("untracked_recent"))
                if limit and len(gone) > 8:
                    d["untracked_recent"] = gone[-8:]
                    extra_gone = len(gone) - 8
                else:
                    extra_gone = 0
                lines_ = fmt_players(d)
                if extra:
                    lines_.append("    … +%d more tracked entities (real players first, then nearest; --limit 0 shows all)" % extra)
                if extra_gone:
                    lines_.append("    … +%d older untracks" % extra_gone)
            else:
                lines_ = {"self": lambda: [fmt_self(d)], "party": lambda: fmt_party(d), "map": lambda: fmt_map(d),
                          "world": lambda: fmt_world(d), "entities": lambda: fmt_entities(d), "soul": lambda: fmt_soul(d, 200),
                          "screen": lambda: fmt_screen(d)}[p]()
            lines_[0] += "   [%.1fs old]" % ((when - t) / 1000)
        except UNEXPECTED:
            lines_ = ["%s: unrecognised data %s" % (p, json.dumps(d, ensure_ascii=False, default=str)[:200])]
        out(lines_)
    if st.get("menu"):
        print('menu open: "%s" since %s' % (txt(st["menu"][1].get("title")), rel(st["menu"][0], t0)))
    for key, label in (("last_title", "last title"), ("last_mark", "last mark")):
        if st.get(key):
            t, d = st[key]
            print("%s: %s (%s)" % (label, d.get("text") if key == "last_title" else "#%s %s" % (d.get("n"), d.get("label")), rel(t, t0)))
    print("recent chat:")
    for t, text in st["chat"]:
        print("   %s %s" % (rel(t, t0), flat(txt(text))))


def replay_track(args, path, rng):
    who, t0 = args.arg, rng.t0
    me = rng.head.get("player")
    needle = None if who == "self" else who.encode()
    rows = []
    for k, t, line in rng.scan(path, {"self", "players", "party"}, needle):
        if k == "self":
            if who not in ("self", me):
                continue
        elif k == "party" and not args.party:
            continue
        elif k == "players" and who == "self":
            continue
        e = event(line)
        d = e.get("data")
        if not isinstance(d, dict):
            continue
        if k == "self":
            rows.append((e, d.get("pos"), d.get("yaw"), "self"))
        elif k == "players":
            for p in d.get("players", []):
                if p.get("name") == who:
                    rows.append((e, p.get("pos"), p.get("yaw"), "entity"))
        elif k == "party":
            for m in d.get("members", []):
                if m.get("name") == who and m.get("source") != "entity":
                    rows.append((e, m.get("pos"), m.get("yaw"), m.get("source")))
    if not rows:
        sys.exit("no positions for %s (names seen in players frames are case-sensitive; `self` for the recording player)" % who)
    limit = args.limit if args.limit is not None else DEFAULT_LIMIT
    every = args.every
    if every is None and limit and len(rows) > limit:
        every = max(0.1, round((rows[-1][0]["t"] - rows[0][0]["t"]) / 1000 / limit, 1))
        print("# %d samples, thinned to one per %.1fs to stay under %d rows (--every S or --limit 0 for all)" % (len(rows), every, limit), file=sys.stderr)
    if every:
        thinned, last = [], None
        for r in rows:
            if last is None or r[0]["t"] - last >= every * 1000:
                thinned.append(r)
                last = r[0]["t"]
        rows = thinned
    if args.csv:
        w = csv.writer(sys.stdout)
        w.writerow(["t_ms", "rel_s", "tick", "ping", "x", "y", "z", "yaw", "source"])
        for e, p, yaw, src in rows:
            p = p or [None, None, None]
            w.writerow([e["t"], round((e["t"] - t0) / 1000, 3), e.get("tick"), e.get("ping"), p[0], p[1], p[2], yaw, src])
        return
    print("%-10s %-8s %-8s %-32s %-7s %s" % ("time", "tick", "ping", "pos", "yaw", "source"))
    for e, p, yaw, src in rows:
        print("%-10s %-8s %-8s %-32s %-7s %s" % (rel(e["t"], t0), e.get("tick"), e.get("ping"), pos(p, 2), "%.1f" % yaw if yaw is not None else "?", src))


def replay_ticks(args, path, rng):
    """Clock health per server: the server tick (set_time game time) against the raw ping count, and freezes (the ping count standing still)."""
    t0 = rng.t0
    segs, cur, server = [], None, None
    for k, t, line in rng.scan(path, {"self", "connection", "location"}):
        if k == "connection":
            cur, server = None, None
            continue
        if k == "location":
            d = event(line).get("data")
            server = (d.get("server_id") if isinstance(d, dict) else None) or server
            if cur is not None and cur["server"] is None:
                cur["server"] = server
            continue
        clock, ping = stamps(line)
        if cur is None:
            cur = {"t0": t, "t1": t, "server": server, "ping0": None, "ping1": None, "clock": 0, "clock_last": None, "null": 0,
                   "stalls": [], "stall_from": None, "last_ping": None, "t_prev": t}
            segs.append(cur)
        cur["t1"] = t
        if clock is None:
            cur["null"] += 1
        else:
            # Net advance of the clock; a jump (another server's time, a reconnect) is not a duration.
            if cur["clock_last"] is not None and -200 < clock - cur["clock_last"] < 200:
                cur["clock"] += clock - cur["clock_last"]
            cur["clock_last"] = clock
        if ping is None:
            if cur["stall_from"] is None and cur["last_ping"] is not None:
                cur["stall_from"] = cur["t_prev"]
        else:
            cur["ping0"] = cur["ping0"] if cur["ping0"] is not None else ping
            cur["ping1"] = ping
            if cur["last_ping"] is not None:
                if ping == cur["last_ping"]:
                    cur["stall_from"] = cur["stall_from"] or cur["t_prev"]
                elif cur["stall_from"] is not None:
                    if t - cur["stall_from"] >= 500:
                        cur["stalls"].append((cur["stall_from"], t - cur["stall_from"]))
                    cur["stall_from"] = None
            cur["last_ping"], cur["t_prev"] = ping, t
    print("%-9s %-10s %6s %8s %8s %8s %6s %s" % ("from", "server", "secs", "tick/s", "ping/s", "surplus", "null", "freezes ≥0.5s (the ping count standing still; longest)"))
    shown = Limited(args, 60)
    for s in segs:
        secs = (s["t1"] - s["t0"]) / 1000
        if secs < 3 or (s["clock_last"] is None and s["ping0"] is None):
            continue
        st = s["stalls"]
        rate = s["clock"] / secs
        prate = (s["ping1"] - s["ping0"]) / secs if s["ping0"] is not None else None
        shown.add("%-9s %-10s %6.0f %8.2f %8s %8s %6d %d%s" % (
            rel(s["t0"], t0), s["server"] or "?", secs, rate, ("%.2f" % prate) if prate is not None else "-",
            ("%+.1f%%" % (100 * (prate - rate) / rate)) if prate is not None and rate else "-", s["null"], len(st),
            (" (%.1fs at %s)" % (max(x[1] for x in st) / 1000, rel(max(st, key=lambda x: x[1])[0], t0))) if st else ""))
    shown.flush("segments")
    print("tick/s is the server's game time per second (~TPS, 19.6 on Hypixel); ping/s counts the per-tick ping, which overcounts by about 2 per attribute update of the player's own entity "
          "and continues across servers (never resets). Use the tick, never the ping count, for durations.")


def replay_sizes(args, path, rng):
    """Where the bytes are: per kind, per raw packet type, and the busiest minutes (raw, uncompressed)."""
    t0 = rng.t0
    kinds, kb, pt, pb, minute = collections.Counter(), collections.Counter(), collections.Counter(), collections.Counter(), collections.Counter()
    for line in lines(path):
        m = PRE.match(line)
        if not m:
            continue
        k = m.group(4).decode()
        kinds[k] += 1
        kb[k] += len(line)
        minute[(int(m.group(1)) - t0) // 60000] += len(line)
        if k == "packet":
            pm = PKT.search(line, 0, 220)
            ty = pm.group(1).decode() if pm else "?"
            pt[ty] += 1
            pb[ty] += len(line)
    raw = sum(kb.values())
    print("%s: %s on disk, %s raw, %d lines" % (path.name, mb(disk_size(path)), mb(raw), sum(kinds.values())))
    print("%-20s %9s %10s %6s" % ("kind", "lines", "raw", "share"))
    for k, n in sorted(kinds.items(), key=lambda kv: -kb[kv[0]])[:20]:
        print("%-20s %9d %10s %5.1f%%" % (k, n, mb(kb[k]), 100 * kb[k] / raw))
    if pt:
        print("\npacket types (inside kind packet):")
        for ty, n in sorted(pt.items(), key=lambda kv: -pb[kv[0]])[:15]:
            print("  %-26s %8d %10s" % (ty, n, mb(pb[ty])))
    busiest = minute.most_common(5)
    print("\nraw MB per minute: average %.1f, busiest %s (writer budget default 96 MB/min)" % (
        raw / 1e6 / max(1, len(minute)), ", ".join("%s %.1f" % (rel(t0 + m * 60000, t0), v / 1e6) for m, v in busiest)))


