def capture_file(game):
    d = game / "soul-dev/captures"
    d.mkdir(parents=True, exist_ok=True)
    path = d / (datetime.now().strftime("%Y-%m-%d_%H-%M-%S") + ".ndjson")
    latest = d / "latest.ndjson"
    try:
        if latest.is_symlink() or latest.exists():
            latest.unlink()
        latest.symlink_to(path.name)
    except OSError:
        pass
    return path


def cmd_listen(args):
    game = target_game(args)
    info = bridge_info(game)
    q = {}
    for key in ("kinds", "types", "channels", "state", "ent", "soul", "preset"):
        if getattr(args, key):
            q[key] = getattr(args, key)
    if args.tick_budget_ms:
        q["tick_budget_ms"] = args.tick_budget_ms
    if args.all:
        q["all"] = "1"
    if args.out:
        q["out"] = "1"
    if args.dir != "in":
        q["dir"] = args.dir
    if args.backlog:
        q["backlog"] = "1"
    if args.no_snapshot:
        q["snapshot"] = "0"
    until_close, idle = False, None
    if args.until == "screen_close":
        until_close = True
    elif args.until and args.until.startswith("idle:"):
        idle = float(args.until[5:])
    elif args.until:
        sys.exit("--until is screen_close or idle:SECS")
    sock, buf = request(info, "/events" + ("?" + urllib.parse.urlencode(q) if q else ""), timeout=30)
    save = None if args.no_save else capture_file(game)
    fh = open(save, "w") if save else None
    start, last, count, reason = time.time(), None, 0, None
    sock.settimeout(0.5)
    try:
        while reason is None:
            now = time.time()
            if args.timeout and now - start >= args.timeout:
                reason = "timeout %ss" % args.timeout
                break
            if idle is not None and last is not None and now - last >= idle:
                reason = "idle %ss" % idle
                break
            if b"\n" not in buf:
                try:
                    chunk = sock.recv(65536)
                except socket.timeout:
                    continue
                if not chunk:
                    reason = "bridge closed the stream (client quit?)"
                    break
                buf += chunk
                continue
            raw, buf = buf.split(b"\n", 1)
            if not raw.strip():
                continue
            ev = json.loads(raw)
            kind = ev.get("kind")
            if kind == "heartbeat":
                continue
            if fh:
                fh.write(raw.decode() + "\n")
                fh.flush()
            if args.json:
                print(raw.decode(), flush=True)
            else:
                out(fmt(ev))
            if kind in ("hello", "dropped", "snapshot", "backlog") or kind in PROVIDERS:
                continue
            count += 1
            last = time.time()
            if until_close and kind == "screen_close":
                reason = "screen_close"
            elif args.max and count >= args.max:
                reason = "max %d events" % args.max
    except KeyboardInterrupt:
        reason = "interrupted"
    finally:
        sock.close()
        if fh:
            fh.close()
    print("# end: %s; %d events%s" % (reason, count, "; capture %s" % save if save else ""),
          file=sys.stderr if args.json else sys.stdout, flush=True)


def cmd_record(args):
    game = target_game(args)
    info = bridge_info(game)
    if args.action == "stop":
        res = fetch_json(info, "/record/stop")
        return print(json.dumps(res, indent=2) if args.json else fmt_record(res))
    if args.action == "status":
        res = fetch_json(info, "/record/status")
        return print(json.dumps(res, indent=2) if args.json else (fmt_record(res) if res.get("file") else "not recording"))
    q = dict(label=args.label, state=args.state, packets=args.packets, max_min=args.max_min, max_mb=args.max_mb, max_total_min=args.max_total_min,
             budget_mb_min=args.budget, kinds=args.kinds, ent=args.ent, soul=args.soul, dir=None if args.dir == "in" else args.dir,
             preset=args.preset, tick_budget_ms=args.tick_budget_ms, out="1" if args.out else None)
    if args.no_backlog:
        q["backlog"] = "0"
    if args.detach:
        res = fetch_json(info, "/record/start" + query(**q))
        print("recording (detached, until `listen record stop` or %s min total; a new file every %s min / %s MB): %s" % (
            res["caps"]["max_total_min"], res["caps"]["max_min"], res["caps"]["max_mb"], res["file"]))
        if wants_outbound(args):
            time.sleep(OUT_WAIT_SECS)
            warn_if_no_outbound(info, True)
        return
    q["hold"] = "1"
    sock, buf = request(info, "/record/start" + query(**q), timeout=30)
    sock.settimeout(0.5)
    start, final = time.time(), None
    print("recording; Ctrl-C or --for ends it (a dying listen ends it too)", flush=True)
    checked = not wants_outbound(args)
    try:
        while True:
            if not checked and time.time() - start >= OUT_WAIT_SECS:
                checked = True
                warn_if_no_outbound(info, True)
            if args.for_secs and time.time() - start >= args.for_secs:
                break
            if b"\n" not in buf:
                try:
                    chunk = sock.recv(65536)
                except socket.timeout:
                    continue
                if not chunk:
                    break
                buf += chunk
                continue
            raw, buf = buf.split(b"\n", 1)
            ev = json.loads(raw)
            d = ev.get("data") or {}
            if d.get("stopped"):
                final = d
                break
            print("  %s part %s %ss %s lines %s KiB gz%s" % (Path(d.get("file", "?")).name, d.get("part", 1), d.get("seconds"), d.get("lines"),
                                                    (d.get("compressed_bytes") or 0) // 1024,
                                                    (" dropped %s" % d["dropped"]) if d.get("dropped") else ""), flush=True)
    except KeyboardInterrupt:
        pass
    if final is None:
        final = fetch_json(info, "/record/stop" + query(reason="listen record ended"))
    sock.close()
    print(fmt_record(final))


def fmt_record(r):
    if not isinstance(r, dict) or not r.get("file"):
        return json.dumps(r)
    files = r.get("files") or [r["file"]]
    return "%s: %ss, %s lines, %s bytes raw, %s bytes gz%s%s%s%s" % (
        r["file"], r.get("seconds"), r.get("lines"), r.get("raw_bytes"), r.get("compressed_bytes"),
        (", dropped %s" % r["dropped"]) if r.get("dropped") else "", (" (%s)" % r["stopped"]) if r.get("stopped") else "",
        ("\n  %d files (rolled over): %s\n  (the client recompresses finished files to .zst when zstd is installed)" % (len(files), ", ".join(Path(f).name for f in files))) if len(files) > 1 else "",
        ("\n  " + packet_dirs(r)) if packet_dirs(r) else "")


OUT_WAIT_SECS = 6


def wants_outbound(args):
    return bool(args.out) or args.dir in ("out", "both")


def packet_dirs(rec):
    """`in N, out M (use_item_on 2, swing 5, ...)` from a recording's or stream's packet counts; None from a bridge that predates them."""
    pk = rec.get("packets") if isinstance(rec, dict) else None
    if not isinstance(pk, dict) or "in" not in pk:
        return None
    types = ", ".join("%s %s" % kv for kv in sorted((pk.get("out_types") or {}).items(), key=lambda kv: -kv[1])[:8])
    return "packets in %s, out %s%s" % (pk["in"], pk["out"], (" (%s)" % types) if types else "")


def warn_if_no_outbound(info, wanted):
    """Asked for the client's own packets but none arrived: say so now, not after the fight."""
    if not wanted:
        return
    try:
        rec = fetch_json(info, "/record/status")
    except (OSError, SystemExit, ValueError):
        return
    pk = rec.get("packets") if isinstance(rec, dict) else None
    if not isinstance(pk, dict) or "out" not in pk:
        print("WARNING: this bridge does not count packets per direction, so it predates the outbound fix: install the current one (tools/devbridge/install)", file=sys.stderr, flush=True)
    elif pk["out"] == 0:
        print("WARNING: outbound packets were asked for (--dir both/out or --out) but none arrived in %ss (%s). Standing still still sends a position every second: "
              "check `listen status` (packets in/out), that the player is in a world, and that the installed bridge is current." % (OUT_WAIT_SECS, packet_dirs(rec) or "no counts"),
              file=sys.stderr, flush=True)


