        parts = args.parts
        args.file = None
        if parts[0] not in ("summary", "timeline", "at", "track", "ticks", "sizes"):
            args.file, parts = parts[0], parts[1:]
        if not parts:
            sys.exit("replay [FILE] summary|timeline|at WHEN|track NAME|ticks|sizes")
