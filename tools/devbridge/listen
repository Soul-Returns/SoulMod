    non_air = 0
    for sid, n in counts.items():
        name = cap.states.get(sid, "?%d" % sid)
        base = name.split("[")[0]
        by_name[base] += n
        if base not in ("minecraft:air", "minecraft:cave_air", "minecraft:void_air"):
            non_air += n
    total = sum(counts.values())
    print("blocks as first seen: %d total, %d non-air (%d distinct states, %d block types; counted in %.1fs)" % (total, non_air, len(counts), len(by_name), time.time() - t0))
    limit = len(by_name) if args.all else args.top
    for name, n in by_name.most_common(limit):
        print("  %10d  %s" % (n, short_state(name)))
    if len(by_name) > limit:
        print("  … %d more block types (--all)" % (len(by_name) - limit))
    bes = collections.Counter()
    firsts = [b for b in cap.block_entities if b.kind == 0]
    heads, signs = 0, []
    for b in firsts:
        try:
            tag = worldfile.parse_nbt(b.nbt)
        except Exception:
            tag = {}
        bes[tag.get("id", "?")] += 1
        if "profile" in tag or "SkullOwner" in tag:
            heads += 1
        if "front_text" in tag and len(signs) < 5:
            messages = tag["front_text"].get("messages", []) if isinstance(tag.get("front_text"), dict) else []
            signs.append(((b.x, b.y, b.z), [str(m)[:40] for m in messages if m not in ('""', "")][:4]))
    print()
    print("block entities: %d first-seen (+%d updates)%s" % (len(firsts), len(cap.block_entities) - len(firsts), ": " + ", ".join("%s %d" % (k.replace("minecraft:", ""), v) for k, v in bes.most_common()) if bes else ""))
    if heads:
        print("  %d with a profile (player heads)" % heads)
    for at, msgs in signs:
        print("  sign at %s: %s" % (at, msgs))
    ents = collections.Counter(e.type for e in cap.entities if e.kind == 0)
    print("entities: %d first-seen (+%d updates)%s" % (sum(ents.values()), sum(1 for e in cap.entities if e.kind == 1), ": " + ", ".join("%s %d" % (k.replace("minecraft:", ""), v) for k, v in ents.most_common()) if ents else ""))
    names = collections.Counter()
    for e in cap.entities:
        if e.kind != 0:
            continue
        try:
            n = worldfile.parse_nbt(e.nbt).get("CustomName")
        except Exception:
            n = None
        if n:
            names[txt(str(n))[:60]] += 1
    for n, c in names.most_common(args.top):
        print("  %3d × %s" % (c, n))
    changes = sum(len(c[2]) for c in cap.changes)
    if cap.changes:
        t1, t2 = cap.changes[0][0], cap.changes[-1][0]
        after = collections.Counter(short_state(cap.states.get(e[3], "?")).split("[")[0] for c in cap.changes for e in c[2])
        print()
        print("block changes after first sight: %d in %d batches (%d from re-sent chunks), %.1fs..%.1fs after the start" % (
            changes, len(cap.changes), sum(len(c[2]) for c in cap.changes if c[1] == 1), t1 / 1000, t2 / 1000))
        print("  became: " + ", ".join("%s %d" % kv for kv in after.most_common(8)))
        ticks = [c[1] for c in cap.clocks if c[1] >= 0]
        if ticks:
            print("  server ticks: %d clock records, tick %d..%d (`cap.tick_at(t)` in worldfile.py maps a record's time to its tick)" % (len(cap.clocks), min(ticks), max(ticks)))
        else:
            print("  no server tick recorded (a capture from before 2026-11-12, or no set_time yet)")
    else:
        print("\nno block changes logged")
    if holes:
        print()
        regions = hole_regions(holes)
        print("holes: %d chunk columns never seen, %d region(s):" % (len(holes), len(regions)))
        for group, (x1, z1, x2, z2) in regions[:20]:
            print("  x %d..%d, z %d..%d  (%d columns)" % (x1 * 16, x2 * 16 + 15, z1 * 16, z2 * 16 + 15, len(group)))
    elif stored:
        print("\nno holes: every chunk column of the stored bounds is in the file")


def world_entities(args):
    path = world_path(args)
    if not path.exists():
        sys.exit("no capture at %s" % path)
    cap = worldfile.read(path)
    rules = worldfile.EntityRules(args.rules)
    info = rules.classify(cap)
    kept = [i for i in info.values() if i.keep]
    noise = [i for i in info.values() if not i.keep]
    print("%s: %d entities; %d static and kept, %d dropped (moved more than %.1f blocks, or matching a drop rule)" % (path.name, len(info), len(kept), len(noise), rules.max_move))
    why = collections.Counter(i.why if not i.why.startswith("moved") else "moved" for i in noise)
    print("dropped: " + ", ".join("%d %s" % (v, k) for k, v in why.most_common()))
    named = collections.defaultdict(list)
    plain = collections.Counter()
    for i in kept:
        f = i.first
        if i.type.endswith("item_frame"):
            item = (worldfile.parse_nbt(f.nbt).get("Item") or {}).get("id", "empty").replace("minecraft:", "")
            named[(i.type.replace("minecraft:", ""), item)].append(i)
        elif i.name:
            named[("named", i.name)].append(i)
        else:
            nb = worldfile.parse_nbt(f.nbt)
            eq = nb.get("equipment") or {}
            plain[(i.type.replace("minecraft:", ""), ", ".join(("%s=%s" % (k, v.get("id") if isinstance(v, dict) else v)).replace("minecraft:", "") for k, v in sorted(eq.items())) or "no equipment")] += 1
    print("\nuseful (named or item frames), with first-seen positions:")
    for (kind, label), lst in sorted(named.items(), key=lambda kv: (kv[0][0], -len(kv[1]), kv[0][1])):
        pos = ["%.1f %.1f %.1f" % (i.first.x, i.first.y, i.first.z) for i in lst[:6]]
        later = [n for n in dict.fromkeys(n for i in lst for n in i.names[1:]) if n]
        print("  %-12s %-40r ×%d  %s%s%s" % (kind, label, len(lst), "; ".join(pos), " …" if len(lst) > 6 else "", ("   (later also: %s)" % ", ".join(repr(n) for n in later)) if later else ""))
    if plain:
        print("\nunnamed static stands (decor, boss models; kept): %d" % sum(plain.values()))
        for (kind, eq), v in plain.most_common(8):
            print("  %4d × %s, %s" % (v, kind, eq))


def world_merge(args):
    paths = [Path(p) for p in args.parts[1:]]
    if not paths or (len(paths) < 2 and args.entities == "all"):
        sys.exit("world merge A B… [-o OUT] [--entities static]   (one file is enough with --entities static)")
    caps = [worldfile.read(p) for p in paths]
    rules = worldfile.EntityRules(args.rules) if args.entities == "static" else None
    dropped = collections.Counter()
    base = caps[0]
    merged = worldfile.Capture()
    started = min(c.started for c in caps)
    boxes = [c.header.get("bounds", {}).get("stored") for c in caps if c.header.get("bounds", {}).get("stored")]
    stored = [min(b[i] for b in boxes) if i < 3 else max(b[i] for b in boxes) for i in range(6)] if boxes else None
    merged.header = dict(base.header, label=(base.header.get("label") or "merged") + "+merged", started=started,
                         merged_from=[p.name for p in paths], bounds={"requested": stored, "stored": stored})
    if stored:
        merged.header["columns_total"] = ((stored[3] >> 4) - (stored[0] >> 4) + 1) * ((stored[5] >> 4) - (stored[2] >> 4) + 1)
    ids = {}

    def state_id(name):
        if name not in ids:
            ids[name] = len(ids)
            merged.states[ids[name]] = name
        return ids[name]

    conflicts, origin = [], {}
    be_seen, ent_seen, dup_entities = {}, {}, 0
    for n, (path, cap) in enumerate(zip(paths, caps)):
        remap = {sid: state_id(name) for sid, name in cap.states.items()}
        shift = cap.started - started
        for key, sec in cap.sections.items():
            mapped = worldfile.Section(sec.t + shift, [remap[p] for p in sec.palette], sec.bits, sec.longs)
            if key not in merged.sections:
                merged.sections[key] = mapped
                origin[key] = n
                continue
            have = merged.sections[key].blocks()
            new = mapped.blocks()
            if have != new:
                diff = sum(1 for a, b in zip(have, new) if a != b)
                conflicts.append((key, origin[key], n, diff))
        for b in cap.block_entities:
            pos = (b.x, b.y, b.z)
            if b.kind == 0 and pos in be_seen:
                if be_seen[pos] != b.nbt:
                    pass
                continue
            if b.kind == 1 and pos not in be_seen:
                continue
            be_seen[pos] = b.nbt
            merged.block_entities.append(worldfile.BlockEntity(b.t + shift, b.kind, b.x, b.y, b.z, b.nbt))
        owned = {}
        verdict = rules.classify(cap) if rules else {}
        for e in cap.entities:
            uid = (e.uuid_hi, e.uuid_lo)
            if e.kind == 0:
                info = verdict.get(uid)
                if info is not None and not info.keep:
                    dropped[info.why if not info.why.startswith("moved") else "moved"] += 1
                    owned[uid] = False
                    continue
                # the same thing seen before (this capture re-sees entities whenever a chunk reloads): same look and
                # name within 0.6 blocks (stands bob a little)
                sig = worldfile.entity_signature(e)
                near = next((q for q in ent_seen.get(sig, ()) if abs(q[0] - e.x) < 0.6 and abs(q[1] - e.y) < 0.6 and abs(q[2] - e.z) < 0.6), None)
                if near is not None:
                    dup_entities += 1
                    owned[uid] = False
                    continue
                ent_seen.setdefault(sig, []).append((e.x, e.y, e.z))
                owned[uid] = True
            elif not owned.get(uid):
                continue
            merged.entities.append(worldfile.Entity(e.t + shift, e.kind, e.id, e.uuid_hi, e.uuid_lo, e.type, e.x, e.y, e.z, e.yaw, e.pitch, e.nbt))
        for t, source, entries in cap.changes:
            merged.changes.append((t + shift, source, [(x, y, z, remap[sid]) for x, y, z, sid in entries]))
        merged.clocks += [(t + shift, tick, ping) for t, tick, ping in cap.clocks]
    merged.clocks.sort()
    merged.end = {"reason": "merged", "sources": [p.name for p in paths]}
    out_path = Path(args.output) if args.output else paths[0].with_name(datetime.now().strftime("%Y-%m-%d_%H-%M-%S") + "_merged" + worldfile_suffix(paths[0]))
    worldfile.write(out_path, merged)
    cols = {(cx, cz) for cx, cz, _ in merged.sections}
    kept = len({(e.uuid_hi, e.uuid_lo) for e in merged.entities})
    print("merged %d captures → %s (%s): %d columns, %d sections, %d block entities, %d entities (%d duplicates of entities already seen dropped), %d change batches" % (
        len(paths), out_path, mb(out_path.stat().st_size), len(cols), len(merged.sections), len(merged.block_entities), kept, dup_entities, len(merged.changes)))
    if rules:
        print("entity filter (%s): dropped %d: %s" % (Path(args.rules).name if args.rules else "entity-filter.json", sum(dropped.values()),
                                                      ", ".join("%d %s" % (v, k) for k, v in dropped.most_common())))
    for i, path in enumerate(paths):
        print("  [%d] %s: %d sections first (won), %d columns" % (i, path.name, sum(1 for v in origin.values() if v == i), len({(k[0], k[1]) for k, v in origin.items() if v == i})))
    if conflicts:
        print("CONFLICTS: %d sections exist in several captures with different blocks (first-seen kept):" % len(conflicts))
        for key, a, b, diff in sorted(conflicts, key=lambda c: -c[3])[:15]:
            print("  column %d,%d section y %d (blocks x %d..%d y %d..%d z %d..%d): [%d] vs [%d], %d blocks differ" % (
                key[0], key[1], key[2], key[0] * 16, key[0] * 16 + 15, key[2] * 16, key[2] * 16 + 15, key[1] * 16, key[1] * 16 + 15, a, b, diff))
        if len(conflicts) > 15:
            print("  … %d more" % (len(conflicts) - 15))
    else:
        print("no conflicts: overlapping sections are identical")


