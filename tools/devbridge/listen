#!/usr/bin/env python3
"""Agent CLI for the SoulMod dev bridge (dev-only mod `soul-devbridge`, loopback only, read-only).

TARGET (which running client; default: the only one running, else pick one)
  --dev           the dev client (runClient, game dir <repo>/run)
  --test          the agent test client instance (soulmod-test)
  --skyblock      the user's "Hypixel Skyblock" Prism instance
  --instance NAME any Prism instance by name     --pid N   by process     --game-dir DIR

LIVE
  status                                  every running client with a bridge (or one: details, streams, costs)
  snapshot [--providers a,b] [--ent SPEC] [--soul a,b] [--json]
                                          every provider at once: self, players, entities, map, party, world, soul, screen
  listen [FILTERS] [STOP] [OUTPUT]        stream events (+ provider frames with --state); starts with a full snapshot
  record [start] [--for SECS|--detach] [--label L] [--state SPEC] [--packets default|none|a,b] [--max-min N] [--max-mb N] [--max-total-min N]
         [--preset full [--out]] [--tick-budget-ms F]
                                          --preset full: every packet needed to reconstruct a fight (entity spawn/remove/metadata/equipment/movement/teleport/
                                          head rotation/velocity/passengers/links/events/damage/hurt/animate/effects/attributes/health, block + section updates,
                                          block events and block entity data, explosions, particles, sounds, level events, boss bars, player position, pickups,
                                          set_time and every ping (with their hook order `seq`);
                                          --dir both (or out, or the older --out) adds the player's own packets (observed, never sent): use_item/use_item_on/interact/
                                          player_action/swing/set_carried_item, container_click/close/button, player_input/command (sneak, sprint), movement,
                                          accept_teleportation, chat and commands (credential commands like /login keep only the command word);
                                          `status` and the end of `record` show packets in/out per type, and `record` warns after 6 s if none arrived;
                                          never chunks, light, keep-alives. Every packet is serialized under a hard cap (an oversized one becomes a stub) and the
                                          bridge sheds a packet type that costs the game more than --tick-budget-ms (default 2) per tick on average (`status`).
  record stop | record status             one recording at a time, written by the client to soul-dev/recordings/
  mark [LABEL…]                           drop a mark now (as the agent)
  shot                                    screenshot of the client's current frame -> prints the PNG path
  log [N] [--grep RE]                     tail the client's own latest.log (the path the bridge reports)

FILES (recordings: soul-dev/recordings/*.rec.ndjson.{zst,gz}, streamed in one pass, ~1 s per GB; default = latest of the target)
  replay [FILE] summary | ticks | sizes | timeline | at <WHEN> | track <NAME|self>
      timeline [--events] [--kinds a,b|--all] [--grep REGEX] [--player NAME]   (default kinds: chat, title, bossbar, places, menus, marks)
      at WHEN: +SECS, +MM:SS, HH:MM:SS, tick=N (the server tick; gt=N is the same), ping=N (raw ping count)     track: [--csv] [--every S] [--party]
      every `tick` is the server game time from set_time (recording format v2; v1 files: their `gt`), `ping` the raw per-tick-ping count (diagnostic: overcounts)
      every replay-like command takes --from WHEN --to WHEN --limit N (default 300; 0 = all) --tail
  marks [FILE] [--json]                   marks from a recording, or the client's soul-dev/marks.ndjson
  menus [FILE] [--title REGEX] [--inv]    per-screen grid + lore of a capture or recording (default: the first 20 screens)
  recompress FILE.gz… [--rm]              gzip → zstd (the client does this itself after a recording when zstd is installed)

WORLD CAPTURE (copies the chunks the client holds, read-only; files in soul-dev/worlds/*.soulworld.gz, see skill live-research)
  world start [--label L] [--bounds x1,y1,z1,x2,y2,z2 | --around R] [--max-chunks N] [--budget-ms F] [--max-min N] [--max-mb N]
  world status                            progress, cost, and the holes (chunk columns in the bounds never seen) as a map + walk hints
  world stop                              ends it, prints the summary and holes
  world info [FILE] [--top N] [--all]     bounds, coverage map, block counts, block entities, entities, changes, holes (default: latest)
  world merge A [B…] [-o OUT] [--entities static]
                                          one capture from several of the same place: blocks first-seen from the first file, block entities and
                                          entities as the union, conflicts reported; --entities static drops mob tags, damage numbers, chat-like
                                          lines and anything that moved (rules: tools/devbridge/entity-filter.json, or --rules FILE)
  world entities [FILE] [--rules F]       the entities of a capture split into useful static ones (with positions) and noise, by those rules

FILTERS  --kinds a,b   events: screen_open,screen_contents,slot_update,page,screen_close,click,chat,mark (default)
                       also inventory_contents,inventory_slot,actionbar,sidebar,tab,title,bossbar,location,connection,
                       tracking,record,screenshot,packet; all
         --state SPEC  provider frames: self:10,players:5,party,world,map,soul,screen,entities (Hz, or on change)
         --ent SPEC    entities provider: radius:30,type:armor_stand|zombie,name:Keeper,max:100
         --soul a,b    soul provider: only these DevState names
         --types w,..  raw packets whose type id contains a word   --channels w,..   --all   --dir in|out|both
         --backlog     first replay the always-on backlog (last minutes of chat/titles/places/marks)
         --no-snapshot skip the snapshot that starts every stream
STOP     --until screen_close | idle:SECS     --timeout SECS     --max N
OUTPUT   --json raw NDJSON  --inv player-inventory slots  --legacy keep § codes  --full-lore  --no-save
"""
